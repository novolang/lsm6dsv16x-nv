// lsm6dsv16x_tests — the driver over a double of the part: a register file
// with an embedded functions bank that answers on an I2C bus and on an SPI
// bus the way ST's data sheet (DS13510 revision 3, §§ 5.1 and 9) says an
// LSM6DSV16X does, so the control byte, the address increment, WHO_AM_I,
// every conversion, the rates and operating modes, the FIFO words and the
// game rotation vector, the self-tests and the bring-up are checked on the
// host, one transaction at a time.  The log keeps what the controller sent,
// in a form the tests compare.
//
// Log entries: an I2C write is 1, the address, the bytes sent, -1; an I2C
// read is 2, the address, the register, the count, -1; an SPI transaction
// is 3, the bytes the controller clocked out, -1.

use std.test
use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, AccelFifoMode, AccelMode, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }
use lsm6dsv16x
use lsm6dsv16x.{ Lsm6dsv16x, Lsm6dsv16xSpi, Lsm6dsv16xMode, Lsm6dsv16xPort, Lsm6dsv16xQuat }

// ── The double ───────────────────────────────────────────────────────
//
// `regs` is the part's registers: the user bank at its addresses and the
// embedded functions bank at 256 more.  `st` is the double's state: 0 is 0
// before an SPI control byte and 1 after it, 1 the register, 2 R/W, 4 1
// when a part is there, 9 1 inside an SPI transaction, 10 the number of
// FIFO words taken, 20 and 21 the SPI clock and mode, 22 the I2C clock, 30
// to 32 the counts the accelerometer's self-test adds to X, Y and Z, 33 to
// 35 the gyroscope's, 41 and 42 the XLDA and GDA flags, 43 1 to set both
// whenever STATUS_REG is read, 44 and 45 the grants of that when 45 is 1, 50
// the microseconds waited, 51 the waits, 67 1 to keep no log, 70 the I2C
// address, 98 the bytes in the FIFO and 99 the entries in the log.  `ro`
// lists registers (by key) that ignore a write.  `fifo` holds the FIFO's
// words as seven bytes each, and `log` the log.

struct Chip
    regs: HashMap<Int, Int>
    st: HashMap<Int, Int>
    ro: HashMap<Int, Int>
    log: HashMap<Int, Int>
    fifo: HashMap<Int, Int>

@tier(app)
fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

// The registers as a global reset leaves them: WHO_AM_I, CTRL3 with BDU and
// IF_INC, SFLP_ODR at its default, the rest 0.
@tier(app)
fn defaults(c: Chip)
    for r in 0..512
        c.regs.insert(r, 0)
    c.regs.insert(0x0F, 0x70)
    c.regs.insert(0x12, 0x44)
    c.regs.insert(0x15E, 0x5B)

// The chip with its reset values in place.
@tier(app)
fn chip() -> Chip
    let c = Chip { regs: HashMap.new(),
        st: HashMap.new(),
        ro: HashMap.new(),
        log: HashMap.new(),
        fifo: HashMap.new() }
    defaults(c)
    c.st.insert(4, 1)
    c.st.insert(70, 0x6A)
    c

// Appends a value to the log, unless the test keeps none.
@tier(app)
fn log_push(c: Chip, v: Int)
    if at(c.st, 67) == 1
        return
    let n = at(c.st, 99)
    c.log.insert(n, v)
    c.st.insert(99, n + 1)

// Empties the log.
@tier(app)
fn log_clear(c: Chip)
    c.st.insert(99, 0)

// Whether a multiple-byte transfer advances the address: IF_INC.
@tier(app)
fn inc_of(c: Chip) -> Int
    if (at(c.regs, 0x12) & 0x04) != 0
        return 1
    0

// The FIFO is on in any mode but bypass.
@tier(app)
fn fifo_on(c: Chip) -> Bool
    (at(c.regs, 0x0A) & 0x07) != 0

// The FIFO words that have not been taken.
@tier(app)
fn fifo_left(c: Chip) -> Int
    at(c.st, 98) / 7 - at(c.st, 10)

// FIFO_WTM_IA, bit 7 of FIFO_STATUS2: the FIFO runs and holds at least the
// words FIFO_CTRL1 asks for.
@tier(app)
fn wtm_flag(c: Chip) -> Int
    let wtm = at(c.regs, 0x07)
    if fifo_on(c) and wtm > 0 and fifo_left(c) >= wtm
        return 0x80
    0

// The self-test's push for a gyroscope or accelerometer axis: the part's
// amount, positive or negative by the ST field of CTRL10.
@tier(app)
fn st_push(c: Chip, reg: Int) -> Int
    let c10 = at(c.regs, 0x19)
    if reg >= 0x28
        let axis = (reg - 0x28) / 2
        let f = c10 & 0x03
        if f == 1
            return at(c.st, 30 + axis)
        if f == 2
            return 0 - at(c.st, 30 + axis)
        return 0
    let axis = (reg - 0x22) / 2
    let f = (c10 >> 2) & 0x03
    if f == 1
        return at(c.st, 33 + axis)
    if f == 2
        return 0 - at(c.st, 33 + axis)
    0

// An output register 0x22 to 0x2D: the stored count plus the self-test's
// push, one byte of it.  Reading clears the new-data flag of its sensor.
@tier(app)
fn out_read(c: Chip, reg: Int) -> Int
    if reg >= 0x28
        c.st.insert(41, 0)
    else
        c.st.insert(42, 0)
    let lo = 0x22 + (reg - 0x22) / 2 * 2
    let v = (at(c.regs, lo) | (at(c.regs, lo + 1) << 8)) + st_push(c, reg)
    if (reg - 0x22) % 2 == 0
        return v & 0xFF
    (v >> 8) & 0xFF

// STATUS_REG as the part answers it.
@tier(app)
fn status_read(c: Chip) -> Int
    if at(c.st, 43) == 1
        if at(c.st, 45) == 0
            c.st.insert(41, 1)
            c.st.insert(42, 1)
        elif at(c.st, 44) > 0
            c.st.insert(44, at(c.st, 44) - 1)
            c.st.insert(41, 1)
            c.st.insert(42, 1)
    var v = 0
    if at(c.st, 41) == 1
        v = v | 0x01
    if at(c.st, 42) == 1
        v = v | 0x02
    v

// The bank FUNC_CFG_ACCESS selects: 0 the user bank, 0x100 the embedded
// functions bank, -1 the sensor hub bank, in which the double answers 0.
@tier(app)
fn bank_of(c: Chip) -> Int
    let f = at(c.regs, 0x01)
    if (f & 0x80) != 0
        return 0x100
    if (f & 0x40) != 0
        return -1
    0

// A register as the part answers it.
@tier(app)
fn chip_read(c: Chip, reg: Int) -> Int
    if reg == 0x01
        return at(c.regs, 0x01)
    let bank = bank_of(c)
    if bank < 0
        return 0
    if bank > 0
        return at(c.regs, bank + reg)
    if reg == 0x1E
        return status_read(c)
    if reg >= 0x22 and reg <= 0x2D
        return out_read(c, reg)
    if reg == 0x1B
        return fifo_left(c) & 0xFF
    if reg == 0x1C
        return wtm_flag(c) | ((fifo_left(c) >> 8) & 0x01)
    if reg >= 0x78 and reg <= 0x7E
        if not fifo_on(c) or fifo_left(c) <= 0
            return 0
        let k = at(c.st, 10) * 7 + (reg - 0x78)
        let v = at(c.fifo, k)
        if reg == 0x7E
            c.st.insert(10, at(c.st, 10) + 1)
        return v
    at(c.regs, reg)

// A write to a register, which a read-only one ignores.  SW_POR puts the
// registers back to their defaults, the interface settings too; bypass mode
// empties the FIFO.
@tier(app)
fn chip_write(c: Chip, reg: Int, v: Int)
    let bank = bank_of(c)
    if reg == 0x01
        if at(c.ro, 1) == 1
            return
        if (v & 0x04) != 0
            defaults(c)
            c.st.insert(10, at(c.st, 98) / 7)
            return
        c.regs.insert(1, v & 0xFF)
        return
    if bank < 0 or at(c.ro, bank + reg) == 1
        return
    c.regs.insert(bank + reg, v & 0xFF)
    if bank == 0 and reg == 0x0A and (v & 0x07) == 0
        c.st.insert(10, at(c.st, 98) / 7)

struct FakeI2c
    c: Chip

impl I2cBus for FakeI2c
    @tier(app)
    fn init(self, freq: Int) [hw]
        self.c.st.insert(22, freq)

    @tier(app)
    fn write(self, addr: Int, data: [u8]) -> Bool [hw]
        log_push(self.c, 1)
        log_push(self.c, addr)
        for b in data
            log_push(self.c, b as Int)
        log_push(self.c, -1)
        if addr != at(self.c.st, 70) or at(self.c.st, 4) == 0 or data.len() < 2
            return false
        var r = data[0] as Int
        let inc = inc_of(self.c)
        for i in 1..data.len()
            chip_write(self.c, r, data[i] as Int)
            r = r + inc
        true

    @tier(app)
    fn read(self, addr: Int, n: Int) -> ?[u8] [hw]
        None

    @tier(app)
    fn write_read(self, addr: Int, tx: [u8], n: Int) -> ?[u8] [hw]
        log_push(self.c, 2)
        log_push(self.c, addr)
        log_push(self.c, tx[0] as Int)
        log_push(self.c, n)
        log_push(self.c, -1)
        if addr != at(self.c.st, 70) or at(self.c.st, 4) == 0
            return None
        var r = tx[0] as Int
        let inc = inc_of(self.c)
        var out: [u8] = []
        for _i in 0..n
            list.push(out, chip_read(self.c, r) as u8)
            r = r + inc
        Some(out)

struct FakeSpi
    c: Chip

impl SpiBus for FakeSpi
    @tier(app)
    fn init(self, freq: Int, mode: Int) [hw]
        self.c.st.insert(20, freq)
        self.c.st.insert(21, mode)

    @tier(app)
    fn transfer(self, b: Int) -> Int [hw]
        if at(self.c.st, 9) == 1
            log_push(self.c, b)
        if at(self.c.st, 4) == 0
            return 0xFF
        if at(self.c.st, 0) == 0
            self.c.st.insert(0, 1)
            self.c.st.insert(1, b & 0x7F)
            self.c.st.insert(2, (b >> 7) & 1)
            return 0xFF
        let r = at(self.c.st, 1)
        self.c.st.insert(1, (r + inc_of(self.c)) & 0x7F)
        if at(self.c.st, 2) == 1
            return chip_read(self.c, r)
        chip_write(self.c, r, b)
        0xFF

    @tier(app)
    fn write(self, data: [u8]) [hw]
        for b in data
            let _ = self.transfer(b as Int)

    @tier(app)
    fn read(self, n: Int) -> [u8] [hw]
        var out: [u8] = []
        for _i in 0..n
            list.push(out, self.transfer(0xFF) as u8)
        out

// The GPIO double: the chip select (pin 67) falling starts an SPI
// transaction and rising ends it.
struct FakePins
    c: Chip
    levels: HashMap<Int, Int>
    modes: HashMap<Int, Int>

impl GpioOut for FakePins
    @tier(app)
    fn mode(self, pin: Int, dir: Int) [hw]
        self.modes.insert(pin, dir)

    @tier(app)
    fn set(self, pin: Int, val: Int) [hw]
        self.levels.insert(pin, val)
        if pin == 67 and val == 0
            self.c.st.insert(0, 0)
            self.c.st.insert(9, 1)
            log_push(self.c, 3)
        if pin == 67 and val == 1 and at(self.c.st, 9) == 1
            self.c.st.insert(9, 0)
            log_push(self.c, -1)

    @tier(app)
    fn get(self, pin: Int) -> Int [hw]
        at(self.levels, pin)

@tier(app)
fn pins(c: Chip) -> FakePins
    FakePins { c: c, levels: HashMap.new(), modes: HashMap.new() }

// Counts a wait.
@tier(app)
fn waited(c: Chip, us: Int)
    c.st.insert(50, at(c.st, 50) + us)
    c.st.insert(51, at(c.st, 51) + 1)

// The two ports, as a type that holds a bus implements them: every method
// is the package's own function over the double.
struct I2cDut
    bus: FakeI2c
    pins: FakePins
    w: DeviceWiring

impl Lsm6dsv16xPort for I2cDut
    @tier(app)
    fn setup(self) -> Bool [hw]
        lsm6dsv16x.i2c_setup(self.bus, self.pins, self.w)

    @tier(app)
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        lsm6dsv16x.i2c_read_into(self.bus, self.w, reg, n, var dst)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        lsm6dsv16x.i2c_write(self.bus, self.w, reg, v)

    @tier(app)
    fn irq_level(self) -> Int [hw]
        lsm6dsv16x.irq_level_of(self.pins, self.w)

    @tier(app)
    fn on_spi(self) -> Bool [hw]
        false

    @tier(app)
    fn wait_us(self, us: Int) [hw]
        waited(self.bus.c, us)

struct SpiDut
    bus: FakeSpi
    pins: FakePins
    w: DeviceWiring

impl Lsm6dsv16xPort for SpiDut
    @tier(app)
    fn setup(self) -> Bool [hw]
        lsm6dsv16x.spi_setup(self.bus, self.pins, self.w)

    @tier(app)
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        lsm6dsv16x.spi_read_into(self.bus, self.pins, self.w, reg, n, var dst)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        lsm6dsv16x.spi_write(self.bus, self.pins, self.w, reg, v)

    @tier(app)
    fn irq_level(self) -> Int [hw]
        lsm6dsv16x.irq_level_of(self.pins, self.w)

    @tier(app)
    fn on_spi(self) -> Bool [hw]
        true

    @tier(app)
    fn wait_us(self, us: Int) [hw]
        waited(self.bus.c, us)

// A port that refuses one chosen write or one chosen read of a chosen
// register: `fail` maps a register to the number of the write, counted from
// 1, that the bus refuses, and `seen` counts the writes; `rfail` and
// `rseen` do the same for reads.  `quiet` limits the reads of the FIFO's
// tag register to the number in key 0 once key 1 is 1.  It reaches the
// refusals that a read-only register cannot, such as the second write of a
// register.
struct Flaky
    inner: I2cDut
    fail: HashMap<Int, Int>
    seen: HashMap<Int, Int>
    rfail: HashMap<Int, Int>
    rseen: HashMap<Int, Int>
    quiet: HashMap<Int, Int>

impl Lsm6dsv16xPort for Flaky
    @tier(app)
    fn setup(self) -> Bool [hw]
        self.inner.setup()

    @tier(app)
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        let k = at(self.rseen, reg) + 1
        self.rseen.insert(reg, k)
        if at(self.rfail, reg) == k
            dst.clear()
            return false
        if reg == 0x78 and at(self.quiet, 1) == 1
            if at(self.quiet, 0) == 0
                dst.clear()
                return false
            self.quiet.insert(0, at(self.quiet, 0) - 1)
        self.inner.read_regs(reg, n, var dst)

    @tier(app)
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        let n = at(self.seen, reg) + 1
        self.seen.insert(reg, n)
        if at(self.fail, reg) == n
            return false
        self.inner.write_reg(reg, v)

    @tier(app)
    fn irq_level(self) -> Int [hw]
        self.inner.irq_level()

    @tier(app)
    fn on_spi(self) -> Bool [hw]
        self.inner.on_spi()

    @tier(app)
    fn wait_us(self, us: Int) [hw]
        self.inner.wait_us(us)

@tier(app)
fn flaky(c: Chip) -> Flaky
    Flaky { inner: i2c_dut(c),
        fail: HashMap.new(),
        seen: HashMap.new(),
        rfail: HashMap.new(),
        rseen: HashMap.new(),
        quiet: HashMap.new() }

@tier(app)
fn flaky_write(c: Chip, reg: Int, nth: Int) -> Flaky
    let f = flaky(c)
    f.fail.insert(reg, nth)
    f

@tier(app)
fn flaky_read(c: Chip, reg: Int, nth: Int) -> Flaky
    let f = flaky(c)
    f.rfail.insert(reg, nth)
    f

// The board's wiring: the part at 0x6A on I2C, INT1 on pin 65.
@tier(app)
fn i2c_wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_i2c(0, 0x6A), 65)

// The part on SPI: chip select on pin 67, INT1 on pin 65.
@tier(app)
fn spi_wiring() -> DeviceWiring
    dev_bus.wiring_irq(dev_bus.wiring_spi(0, 67), 65)

@tier(app)
fn i2c_dut(c: Chip) -> I2cDut
    I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: i2c_wiring() }

@tier(app)
fn spi_dut(c: Chip) -> SpiDut
    SpiDut { bus: FakeSpi { c: c }, pins: pins(c), w: spi_wiring() }

// Asserts the log holds exactly `want`, then empties it.
@tier(app)
fn log_is(c: Chip, want: [Int])
    test.assert_eq(at(c.st, 99), want.len())
    for i in 0..want.len()
        test.assert_eq(at(c.log, i), want[i])
    log_clear(c)

@tier(app)
fn reg_of(c: Chip, r: Int) -> Int
    at(c.regs, r)

// A register of the embedded functions bank.
@tier(app)
fn emb_of(c: Chip, r: Int) -> Int
    at(c.regs, 0x100 + r)

// The registers written, in order, from a log of I2C transactions.
@tier(app)
fn written(c: Chip) -> [Int]
    var out: [Int] = []
    var i = 0
    while i < at(c.st, 99)
        let kind = at(c.log, i)
        if kind == 1
            list.push(out, at(c.log, i + 2))
        i = i + 1
        while i < at(c.st, 99) and at(c.log, i - 1) != -1
            i = i + 1
    out

// Sets the 16-bit count of an axis, low byte first, at `reg`.
@tier(app)
fn put16(c: Chip, reg: Int, v: Int)
    let u = v & 0xFFFF
    c.regs.insert(reg, u & 0xFF)
    c.regs.insert(reg + 1, u >> 8)

// Sets the gyroscope's three axes, then the accelerometer's.
@tier(app)
fn put_gyro(c: Chip, x: Int, y: Int, z: Int)
    put16(c, 0x22, x)
    put16(c, 0x24, y)
    put16(c, 0x26, z)

@tier(app)
fn put_accel(c: Chip, x: Int, y: Int, z: Int)
    put16(c, 0x28, x)
    put16(c, 0x2A, y)
    put16(c, 0x2C, z)

// Appends a FIFO word: the sensor tag in the top five bits of the tag
// byte, then three 16-bit counts.
@tier(app)
fn fifo_word(c: Chip, tag: Int, x: Int, y: Int, z: Int)
    let n = at(c.st, 98)
    c.fifo.insert(n, tag << 3)
    var k = 1
    for v in [x, y, z]
        let u = v & 0xFFFF
        c.fifo.insert(n + k, u & 0xFF)
        c.fifo.insert(n + k + 1, u >> 8)
        k = k + 2
    c.st.insert(98, n + 7)

@tier(app)
fn x_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.x
        None    => -99999

@tier(app)
fn y_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.y
        None    => -99999

@tier(app)
fn z_of(o: ?AccelMilliG) -> Int
    match o
        Some(a) => a.z
        None    => -99999

@tier(app)
fn gx_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.x
        None    => -99999

@tier(app)
fn gy_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.y
        None    => -99999

@tier(app)
fn gz_of(o: ?GyroMilliDps) -> Int
    match o
        Some(g) => g.z
        None    => -99999

// ── The two buses' framing ───────────────────────────────────────────

@test
fn test_an_i2c_read_is_the_register_and_a_repeated_start_for_any_count() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.reg_read(d, 0x0F) ?? -1, 0x70)
    log_is(c, [2, 0x6A, 0x0F, 1, -1])
    c.regs.insert(0x20, 11)
    c.regs.insert(0x21, 22)
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x20, 2, var b))
    log_is(c, [2, 0x6A, 0x20, 2, -1])
    test.assert_eq(b[0] as Int, 11)
    test.assert_eq(b[1] as Int, 22)

@test
fn test_an_i2c_write_is_the_register_then_the_byte() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.write_reg(0x10, 0x40))
    log_is(c, [1, 0x6A, 0x10, 0x40, -1])
    test.assert_eq(reg_of(c, 0x10), 0x40)

@test
fn test_a_missing_i2c_part_does_not_answer() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.reg_read(d, 0x0F) == None)
    test.assert(not d.write_reg(0x10, 1))
    test.assert(not lsm6dsv16x.reg_write(d, 0x10, 1))
    test.assert(not lsm6dsv16x.reg_update(d, 0x10, 1, 1))
    test.assert(lsm6dsv16x.id_read(d) == None)

@test
fn test_an_spi_read_sets_rw_and_carries_no_dummy_byte() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert_eq(lsm6dsv16x.reg_read(d, 0x0F) ?? -1, 0x70)
    log_is(c, [3, 0x8F, 0xFF, -1])
    test.assert_eq(at(d.pins.levels, 67), 1)
    c.regs.insert(0x20, 11)
    c.regs.insert(0x21, 22)
    var b: DevBytes = Vec.new()
    test.assert(d.read_regs(0x20, 2, var b))
    log_is(c, [3, 0xA0, 0xFF, 0xFF, -1])
    test.assert_eq(b[0] as Int, 11)
    test.assert_eq(b[1] as Int, 22)

@test
fn test_an_spi_write_clears_rw() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(d.write_reg(0x10, 0x40))
    log_is(c, [3, 0x10, 0x40, -1])
    test.assert_eq(reg_of(c, 0x10), 0x40)

@test
fn test_an_spi_part_that_is_not_there_reads_0xff_and_is_no_part() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = spi_dut(c)
    test.assert_eq(lsm6dsv16x.reg_read(d, 0x0F) ?? -1, 0xFF)
    test.assert(lsm6dsv16x.id_read(d) == None)
    c.st.insert(4, 1)
    c.regs.insert(0x0F, 0)
    test.assert(lsm6dsv16x.id_read(d) == None)

@test
fn test_a_wiring_with_no_chip_select_runs_no_spi_transaction() [io, hw]
    let c = chip()
    let d = SpiDut { bus: FakeSpi { c: c }, pins: pins(c), w: dev_bus.wiring_i2c(0, 0x6A) }
    var b: DevBytes = Vec.new()
    test.assert(not d.read_regs(0x0F, 1, var b))
    test.assert(not d.write_reg(0x10, 1))
    test.assert(not d.setup())
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_wiring_with_no_address_is_not_an_i2c_part() [io, hw]
    let c = chip()
    let d = I2cDut { bus: FakeI2c { c: c }, pins: pins(c), w: dev_bus.wiring_spi(0, 67) }
    test.assert(not d.setup())
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_a_multiple_byte_read_repeats_one_register_while_if_inc_is_clear() [io, hw]
    // With the bit clear, every byte of a burst is the first register, on
    // both buses.
    let c = chip()
    c.regs.insert(0x12, 0x00)
    c.regs.insert(0x20, 11)
    c.regs.insert(0x21, 22)
    var b: DevBytes = Vec.new()
    test.assert(i2c_dut(c).read_regs(0x20, 2, var b))
    test.assert_eq(b[1] as Int, 11)
    test.assert(spi_dut(c).read_regs(0x20, 2, var b))
    test.assert_eq(b[1] as Int, 11)

// ── Setup ────────────────────────────────────────────────────────────

@test
fn test_i2c_setup_makes_the_interrupt_pin_an_input_and_the_bus_fast() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(d.setup())
    test.assert_eq(at(c.st, 22), 400000)
    test.assert_eq(at(d.pins.modes, 65), 0)

@test
fn test_spi_setup_drives_chip_select_high_before_it_is_an_output() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(d.setup())
    test.assert_eq(at(d.pins.levels, 67), 1)
    test.assert_eq(at(d.pins.modes, 67), 1)
    test.assert_eq(at(d.pins.modes, 65), 0)
    test.assert_eq(at(c.st, 20), 4000000)
    test.assert_eq(at(c.st, 21), 3)

@test
fn test_the_interrupt_line_level() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    d.pins.levels.insert(65, 1)
    test.assert_eq(d.irq_level(), 1)
    test.assert_eq(lsm6dsv16x.irq_level_of(d.pins, dev_bus.wiring_i2c(0, 0x6A)), -1)
    let s = spi_dut(c)
    s.pins.levels.insert(65, 1)
    test.assert_eq(s.irq_level(), 1)

@test
fn test_a_wait_reaches_the_port() [io, hw]
    let c = chip()
    i2c_dut(c).wait_us(250)
    spi_dut(c).wait_us(50)
    test.assert_eq(at(c.st, 50), 300)
    test.assert_eq(at(c.st, 51), 2)

// ── Identity ─────────────────────────────────────────────────────────

@test
fn test_the_identity_is_who_am_i_on_both_buses() [io, hw]
    let c = chip()
    match lsm6dsv16x.id_read(i2c_dut(c))
        Some(id) =>
            test.assert_eq(id.who, 0x70)
            test.assert(id.rev == None)
        None     => test.assert(false)
    match lsm6dsv16x.id_read(spi_dut(c))
        Some(id) => test.assert_eq(id.who, 0x70)
        None     => test.assert(false)

// ── The embedded functions bank ──────────────────────────────────────

@test
fn test_a_register_of_the_embedded_bank_is_read_and_the_user_bank_comes_back() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.emb_read(d, 0x5E) ?? -1, 0x5B)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)
    // The user bank's register at the same address is another.
    test.assert_eq(lsm6dsv16x.reg_read(d, 0x5E) ?? -1, 0)
    // The other bits of FUNC_CFG_ACCESS stay.
    c.regs.insert(0x01, 0x03)
    test.assert_eq(lsm6dsv16x.emb_read(d, 0x5E) ?? -1, 0x5B)
    test.assert_eq(reg_of(c, 0x01), 0x03)

@test
fn test_a_visit_to_the_embedded_bank_puts_the_user_bank_back_also_when_it_failed() [io, hw]
    // The read of the register fails: the bank comes back.
    let c = chip()
    test.assert(lsm6dsv16x.emb_read(flaky_read(c, 0x5E, 1), 0x5E) == None)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)
    // The bank cannot be left: the answer is None.
    let g = chip()
    test.assert(lsm6dsv16x.emb_read(flaky_write(g, 0x01, 2), 0x5E) == None)
    // The bank cannot be entered: it is left again.
    let e = chip()
    e.ro.insert(0x01, 1)
    test.assert(lsm6dsv16x.emb_read(i2c_dut(e), 0x5E) == None)
    // The same for an update.
    let i = chip()
    test.assert(lsm6dsv16x.emb_update(i2c_dut(i), 0x5E, 0x38, 0x10))
    test.assert_eq(emb_of(i, 0x5E), 0x53)
    test.assert_eq(reg_of(i, 0x01) & 0xC0, 0)
    let j = chip()
    test.assert(not lsm6dsv16x.emb_update(flaky_read(j, 0x5E, 1), 0x5E, 0x38, 0x10))
    test.assert_eq(reg_of(j, 0x01) & 0xC0, 0)
    let k = chip()
    k.ro.insert(0x01, 1)
    test.assert(not lsm6dsv16x.emb_update(i2c_dut(k), 0x5E, 0x38, 0x10))
    let l = chip()
    test.assert(not lsm6dsv16x.emb_update(flaky_write(l, 0x01, 2), 0x5E, 0x38, 0x10))

// ── Ranges and steps ─────────────────────────────────────────────────

@test
fn test_the_accelerometer_range_codes_are_in_ascending_order() [io, hw]
    test.assert(lsm6dsv16x.accel_range_of(0x00) == AccelRange2g)
    test.assert(lsm6dsv16x.accel_range_of(0x01) == AccelRange4g)
    test.assert(lsm6dsv16x.accel_range_of(0x02) == AccelRange8g)
    test.assert(lsm6dsv16x.accel_range_of(0x03) == AccelRange16g)
    // The filter bits of CTRL8 do not matter.
    test.assert(lsm6dsv16x.accel_range_of(0xE1) == AccelRange4g)
    test.assert_eq(lsm6dsv16x.accel_fs_of(AccelRange2g), 0)
    test.assert_eq(lsm6dsv16x.accel_fs_of(AccelRange4g), 1)
    test.assert_eq(lsm6dsv16x.accel_fs_of(AccelRange8g), 2)
    test.assert_eq(lsm6dsv16x.accel_fs_of(AccelRange16g), 3)

@test
fn test_the_gyroscope_range_codes_include_125_and_4000_dps() [io, hw]
    test.assert(lsm6dsv16x.gyro_range_of(0x01) == GyroRange250dps)
    test.assert(lsm6dsv16x.gyro_range_of(0x02) == GyroRange500dps)
    test.assert(lsm6dsv16x.gyro_range_of(0x03) == GyroRange1000dps)
    test.assert(lsm6dsv16x.gyro_range_of(0x04) == GyroRange2000dps)
    // ±125 dps is the code 0 and ±4000 dps the code 12; a reserved code
    // reads as ±250 dps.
    test.assert(lsm6dsv16x.gyro_range_of(0x00) == GyroRange125dps)
    test.assert(lsm6dsv16x.gyro_range_of(0x0C) == GyroRange4000dps)
    test.assert(lsm6dsv16x.gyro_range_of(0x05) == GyroRange250dps)
    // LPF1_G_BW does not matter.
    test.assert(lsm6dsv16x.gyro_range_of(0x72) == GyroRange500dps)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange125dps), 0)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange250dps), 1)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange500dps), 2)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange1000dps), 3)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange2000dps), 4)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange4000dps), 12)
    // The three ranges below ±125 dps are not the part's.
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange62dps), -1)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange31dps), -1)
    test.assert_eq(lsm6dsv16x.gyro_fs_of(GyroRange15dps), -1)

@test
fn test_the_steps_are_table_3s() [io, hw]
    test.assert_eq(lsm6dsv16x.ug_per_count(0x00), 61)
    test.assert_eq(lsm6dsv16x.ug_per_count(0x01), 122)
    test.assert_eq(lsm6dsv16x.ug_per_count(0x02), 244)
    test.assert_eq(lsm6dsv16x.ug_per_count(0x03), 488)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x00), 4375)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x01), 8750)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x02), 17500)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x03), 35000)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x04), 70000)
    test.assert_eq(lsm6dsv16x.udps_per_count(0x0C), 140000)
    // A reserved code is read at ±250 dps.
    test.assert_eq(lsm6dsv16x.udps_per_count(0x07), 8750)

// ── Rates and operating modes ────────────────────────────────────────

@test
fn test_the_rate_codes_are_the_data_sheets_in_each_rate_set() [io, hw]
    // Tables 52 and 55: 1.875 Hz for the accelerometer, 7.5 Hz up to 7.68 kHz.
    let base = [0, 7500, 15000, 30000, 60000, 120000, 240000, 480000, 960000, 1920000, 3840000, 7680000]
    test.assert_eq(lsm6dsv16x.mhz_of_odr(1, true, 0), 1875)
    test.assert_eq(lsm6dsv16x.mhz_of_odr(1, false, 0), 0)
    for i in 1..12
        test.assert_eq(lsm6dsv16x.mhz_of_odr(i + 1, true, 0), base[i])
        test.assert_eq(lsm6dsv16x.mhz_of_odr(i + 1, false, 0), base[i])
    // Table 20: HAODR_SEL 01 and 10 from code 0011, doubling.
    let one = [15625, 31250, 62500, 125000, 250000, 500000, 1000000, 2000000, 4000000, 8000000]
    let two = [12500, 25000, 50000, 100000, 200000, 400000, 800000, 1600000, 3200000, 6400000]
    for i in 0..10
        test.assert_eq(lsm6dsv16x.mhz_of_odr(i + 3, true, 1), one[i])
        test.assert_eq(lsm6dsv16x.mhz_of_odr(i + 3, false, 2), two[i])
    // The sets have no codes 0001 and 0010; 0000 and 1101 are not rates.
    test.assert_eq(lsm6dsv16x.mhz_of_odr(1, true, 1), 0)
    test.assert_eq(lsm6dsv16x.mhz_of_odr(2, true, 2), 0)
    test.assert_eq(lsm6dsv16x.mhz_of_odr(0, true, 0), 0)
    test.assert_eq(lsm6dsv16x.mhz_of_odr(13, true, 0), 0)

@test
fn test_a_requested_rate_rounds_up_to_a_code_the_mode_runs() [io, hw]
    // High performance: 7.5 Hz up (the accelerometer's 1.875 Hz is low-power).
    test.assert_eq(lsm6dsv16x.odr_code_for(0, true, 0, 0), 0)
    test.assert_eq(lsm6dsv16x.odr_code_for(-5, false, 0, 0), 0)
    test.assert_eq(lsm6dsv16x.odr_code_for(1, true, 0, 0), 2)
    test.assert_eq(lsm6dsv16x.odr_code_for(7500, true, 0, 0), 2)
    test.assert_eq(lsm6dsv16x.odr_code_for(7501, true, 0, 0), 3)
    test.assert_eq(lsm6dsv16x.odr_code_for(100000, false, 0, 0), 6)
    test.assert_eq(lsm6dsv16x.odr_code_for(7680000, false, 0, 0), 12)
    test.assert_eq(lsm6dsv16x.odr_code_for(99999999, false, 0, 0), 12)
    // Low power: the accelerometer's 1.875 Hz and 15 to 240 Hz.
    test.assert_eq(lsm6dsv16x.odr_code_for(1, true, 4, 0), 1)
    test.assert_eq(lsm6dsv16x.odr_code_for(1875, true, 5, 0), 1)
    test.assert_eq(lsm6dsv16x.odr_code_for(1876, true, 6, 0), 3)
    test.assert_eq(lsm6dsv16x.odr_code_for(240000, true, 4, 0), 7)
    test.assert_eq(lsm6dsv16x.odr_code_for(240001, true, 4, 0), 7)
    // The gyroscope in low power: 7.5 to 240 Hz.
    test.assert_eq(lsm6dsv16x.odr_code_for(1, false, 5, 0), 2)
    test.assert_eq(lsm6dsv16x.odr_code_for(500000, false, 5, 0), 7)
    // Normal mode: 7.5 Hz to 1.92 kHz.
    test.assert_eq(lsm6dsv16x.odr_code_for(1, true, 7, 0), 2)
    test.assert_eq(lsm6dsv16x.odr_code_for(9999999, true, 7, 0), 10)
    // High-accuracy ODR mode: 15 Hz up, in the rate set.
    test.assert_eq(lsm6dsv16x.odr_code_for(1, true, 1, 1), 3)
    test.assert_eq(lsm6dsv16x.odr_code_for(15626, true, 1, 1), 4)
    test.assert_eq(lsm6dsv16x.odr_code_for(100000, false, 1, 2), 6)
    test.assert_eq(lsm6dsv16x.odr_code_for(100001, false, 1, 2), 7)

@test
fn test_a_rate_in_whole_hertz_is_rounded_and_zero_when_off() [io, hw]
    test.assert_eq(lsm6dsv16x.hz_of_mhz(0), 0)
    test.assert_eq(lsm6dsv16x.hz_of_mhz(-1), 0)
    test.assert_eq(lsm6dsv16x.hz_of_mhz(1875), 2)
    test.assert_eq(lsm6dsv16x.hz_of_mhz(7500), 8)
    test.assert_eq(lsm6dsv16x.hz_of_mhz(120000), 120)
    test.assert_eq(lsm6dsv16x.hz_of_mhz(7680000), 7680)

@test
fn test_the_rate_is_read_with_the_rate_set_its_mode_selects() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // Off after a reset.
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 0)
    test.assert_eq(lsm6dsv16x.gyro_rate_read(d), 0)
    c.regs.insert(0x10, 0x06)
    c.regs.insert(0x11, 0x07)
    log_clear(c)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 120000)
    log_is(c, [2, 0x6A, 0x10, 1, -1])
    test.assert_eq(lsm6dsv16x.gyro_rate_read(d), 240000)
    // High-accuracy ODR mode reads HAODR_SEL too.
    c.regs.insert(0x10, 0x16)
    c.regs.insert(0x62, 0x01)
    log_clear(c)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 125000)
    log_is(c, [2, 0x6A, 0x10, 1, -1, 2, 0x6A, 0x62, 1, -1])
    c.regs.insert(0x62, 0x02)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 100000)
    c.regs.insert(0x11, 0x16)
    test.assert_eq(lsm6dsv16x.gyro_rate_read(d), 100000)
    // Outside that mode HAODR_SEL does not apply.
    c.regs.insert(0x10, 0x06)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 120000)
    // Low power at 1.875 Hz.
    c.regs.insert(0x10, 0x41)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 1875)
    c.st.insert(4, 0)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), -1)
    test.assert_eq(lsm6dsv16x.gyro_rate_read(d), -1)
    let e = chip()
    e.regs.insert(0x10, 0x16)
    test.assert_eq(lsm6dsv16x.accel_rate_read(flaky_read(e, 0x62, 1)), -1)

@test
fn test_setting_a_rate_writes_the_code_and_keeps_the_mode() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 100000), 120000)
    test.assert_eq(reg_of(c, 0x10), 0x06)
    // The accelerometer needs no wait; the gyroscope waits its 30 ms to turn
    // on when it was off.
    test.assert_eq(at(c.st, 50), 0)
    test.assert_eq(lsm6dsv16x.gyro_rate_write(d, 100000), 120000)
    test.assert_eq(reg_of(c, 0x11), 0x06)
    test.assert_eq(at(c.st, 50), 30000)
    test.assert_eq(lsm6dsv16x.gyro_rate_write(d, 240000), 240000)
    test.assert_eq(at(c.st, 50), 30000)
    // A mode stays.
    c.regs.insert(0x10, 0x50)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 60000), 60000)
    test.assert_eq(reg_of(c, 0x10), 0x55)
    // In low power the rate stays at one the mode runs.
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 1000000), 240000)
    test.assert_eq(reg_of(c, 0x10), 0x57)

@test
fn test_setting_a_rate_in_high_accuracy_mode_uses_haodr_sel() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x10)
    c.regs.insert(0x62, 0x01)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 100000), 125000)
    test.assert_eq(reg_of(c, 0x10), 0x16)
    c.regs.insert(0x62, 0x02)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 100000), 100000)
    test.assert_eq(reg_of(c, 0x10), 0x16)

@test
fn test_setting_a_rate_of_zero_powers_the_sensor_down() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x56)
    c.regs.insert(0x11, 0x06)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 0), 0)
    test.assert_eq(reg_of(c, 0x10), 0x50)
    test.assert_eq(lsm6dsv16x.gyro_rate_write(d, -1), 0)
    test.assert_eq(reg_of(c, 0x11), 0x00)
    test.assert_eq(at(c.st, 50), 0)

@test
fn test_the_rate_setters_answer_minus_one_for_a_part_that_refuses() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.accel_rate_write(d, 100000), -1)
    test.assert_eq(lsm6dsv16x.gyro_rate_write(d, 100000), -1)
    let e = chip()
    test.assert_eq(lsm6dsv16x.accel_rate_write(flaky_write(e, 0x10, 1), 100000), -1)
    test.assert_eq(lsm6dsv16x.gyro_rate_write(flaky_write(e, 0x11, 1), 100000), -1)
    // In high-accuracy mode the read of HAODR_CFG can fail.
    let f = chip()
    f.regs.insert(0x10, 0x10)
    test.assert_eq(lsm6dsv16x.accel_rate_write(flaky_read(f, 0x62, 1), 100000), -1)

@test
fn test_the_rates_in_whole_hertz_are_the_thousandths_rounded() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.accel_rate_hz_write(d, 100), 120)
    test.assert_eq(lsm6dsv16x.accel_rate_hz_read(d), 120)
    test.assert_eq(lsm6dsv16x.gyro_rate_hz_write(d, 5), 8)
    test.assert_eq(lsm6dsv16x.gyro_rate_hz_read(d), 8)

@test
fn test_the_operating_modes_are_read_and_written() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    test.assert(lsm6dsv16x.gyro_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    // The sensors are off: the mode is written alone.
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xNormal))
    test.assert_eq(reg_of(c, 0x10), 0x70)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xNormal)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xLowPower))
    test.assert_eq(reg_of(c, 0x10), 0x40)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xLowPower)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))
    test.assert_eq(reg_of(c, 0x10), 0x10)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert_eq(reg_of(c, 0x10), 0x00)
    test.assert(lsm6dsv16x.gyro_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xLowPower))
    test.assert_eq(reg_of(c, 0x11), 0x50)
    test.assert(lsm6dsv16x.gyro_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xLowPower)
    test.assert(lsm6dsv16x.gyro_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))
    test.assert(lsm6dsv16x.gyro_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy)
    test.assert(lsm6dsv16x.gyro_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert_eq(reg_of(c, 0x11), 0x00)
    // The gyroscope has no normal mode.
    test.assert(not lsm6dsv16x.gyro_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xNormal))
    // Sleep mode, ODR-triggered mode and the reserved codes read as high
    // performance for the gyroscope; the three low-power modes read as low
    // power for the accelerometer.
    c.regs.insert(0x11, 0x40)
    test.assert(lsm6dsv16x.gyro_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    c.regs.insert(0x10, 0x50)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xLowPower)
    c.regs.insert(0x10, 0x60)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xLowPower)
    c.regs.insert(0x10, 0x30)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    c.st.insert(4, 0)
    test.assert(lsm6dsv16x.accel_mode_read(d) == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    test.assert(not lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert(not lsm6dsv16x.gyro_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighPerf))

@test
fn test_the_trait_modes_are_the_nearest_of_the_parts_four() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // High performance after a reset is the finest.
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelHighResolution))
    test.assert(lsm6dsv16x.accel_mode_set(d, AccelMode.AccelNormal))
    test.assert_eq(reg_of(c, 0x10), 0x70)
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelNormal))
    test.assert(lsm6dsv16x.accel_mode_set(d, AccelMode.AccelLowPower))
    test.assert_eq(reg_of(c, 0x10), 0x40)
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelLowPower))
    // The other two low-power modes read as low power too.
    c.regs.insert(0x10, 0x50)
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelLowPower))
    c.regs.insert(0x10, 0x60)
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelLowPower))
    test.assert(lsm6dsv16x.accel_mode_set(d, AccelMode.AccelHighResolution))
    test.assert_eq(reg_of(c, 0x10), 0x00)
    // High-accuracy ODR resolves as finely as high performance.
    c.regs.insert(0x10, 0x10)
    test.assert(lsm6dsv16x.accel_mode_of(d) == Some(AccelMode.AccelHighResolution))
    // A part that does not answer has no mode and takes none.
    c.st.insert(4, 0)
    test.assert(lsm6dsv16x.accel_mode_of(d) == None)
    test.assert(not lsm6dsv16x.accel_mode_set(d, AccelMode.AccelNormal))

@test
fn test_the_low_power_modes_are_chosen_by_the_samples_they_average() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.accel_lp_write(d, 2))
    test.assert_eq(reg_of(c, 0x10), 0x40)
    test.assert(lsm6dsv16x.accel_lp_write(d, 4))
    test.assert_eq(reg_of(c, 0x10), 0x50)
    test.assert(lsm6dsv16x.accel_lp_write(d, 8))
    test.assert_eq(reg_of(c, 0x10), 0x60)
    test.assert(not lsm6dsv16x.accel_lp_write(d, 3))
    test.assert(not lsm6dsv16x.accel_lp_write(d, 0))
    test.assert_eq(reg_of(c, 0x10), 0x60)

@test
fn test_a_mode_change_moves_a_rate_the_new_mode_does_not_run() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // 960 Hz to low power: 240 Hz, the fastest low-power rate.
    c.regs.insert(0x10, 0x09)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xLowPower))
    test.assert_eq(reg_of(c, 0x10), 0x47)
    // 7.5 Hz to high-accuracy ODR mode: 15.625 Hz in set 1.
    let e = chip()
    e.regs.insert(0x62, 0x01)
    e.regs.insert(0x10, 0x02)
    test.assert(lsm6dsv16x.accel_mode_write(i2c_dut(e), Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))
    test.assert_eq(reg_of(e, 0x10), 0x13)
    // The gyroscope in low power to high performance keeps its rate.
    let f = chip()
    f.regs.insert(0x11, 0x55)
    test.assert(lsm6dsv16x.gyro_mode_write(i2c_dut(f), Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert_eq(reg_of(f, 0x11), 0x05)

@test
fn test_high_accuracy_mode_is_entered_and_left_through_power_down() [io, hw]
    // § 6.5: the mode is changed with the sensor in power-down, and the
    // rate written back after it.
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    log_clear(c)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))
    let seen = written(c)
    test.assert_eq(seen.len(), 3)
    test.assert_eq(seen[0], 0x10)
    test.assert_eq(reg_of(c, 0x10), 0x16)
    // Leaving it, the same.
    log_clear(c)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert_eq(written(c).len(), 3)
    test.assert_eq(reg_of(c, 0x10), 0x06)
    // A change that does not touch it is two writes.
    log_clear(c)
    test.assert(lsm6dsv16x.accel_mode_write(d, Lsm6dsv16xMode.Lsm6dsv16xNormal))
    test.assert_eq(written(c).len(), 2)

@test
fn test_a_mode_change_that_a_register_refuses_fails() [io, hw]
    // The writes in order, as (register, which write of it): the power-down,
    // the mode, the rate.
    let regs = [0x10, 0x10, 0x10]
    let nth = [1, 2, 3]
    for i in 0..regs.len()
        let c = chip()
        c.regs.insert(0x10, 0x06)
        test.assert(not lsm6dsv16x.accel_mode_write(flaky_write(c, regs[i], nth[i]), Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))
    // The reads of CTRL1 and HAODR_CFG.
    let d = chip()
    test.assert(not lsm6dsv16x.accel_mode_write(flaky_read(d, 0x10, 1), Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    test.assert(not lsm6dsv16x.gyro_mode_write(flaky_read(d, 0x62, 1), Lsm6dsv16xMode.Lsm6dsv16xHighPerf))
    // A sensor that is off needs no power-down and no rate written back: the
    // mode is the one write.
    let e = chip()
    test.assert(not lsm6dsv16x.accel_mode_write(flaky_write(e, 0x10, 1), Lsm6dsv16xMode.Lsm6dsv16xHighAccuracy))

@test
fn test_the_high_accuracy_rate_set_is_haodr_sel_0_to_2() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x62, 0xFC)
    test.assert(lsm6dsv16x.ha_series_write(d, 1))
    test.assert_eq(reg_of(c, 0x62), 0xFD)
    test.assert(lsm6dsv16x.ha_series_write(d, 2))
    test.assert_eq(reg_of(c, 0x62), 0xFE)
    test.assert(lsm6dsv16x.ha_series_write(d, 0))
    test.assert(not lsm6dsv16x.ha_series_write(d, 3))
    test.assert(not lsm6dsv16x.ha_series_write(d, -1))
    test.assert_eq(reg_of(c, 0x62), 0xFC)
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.ha_series_write(d, 1))

// ── Samples ──────────────────────────────────────────────────────────

@test
fn test_an_acceleration_is_converted_at_each_range() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_accel(c, 1000, -2000, 10000)
    // ±2 g: 61 ug a count.
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 61)
    test.assert_eq(y_of(lsm6dsv16x.accel_read_of(d)), -122)
    test.assert_eq(z_of(lsm6dsv16x.accel_read_of(d)), 610)
    // ±4 g, ±8 g and ±16 g.
    c.regs.insert(0x17, 0x01)
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 122)
    c.regs.insert(0x17, 0x02)
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 244)
    c.regs.insert(0x17, 0x03)
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 488)
    test.assert_eq(y_of(lsm6dsv16x.accel_read_of(d)), -976)

@test
fn test_the_largest_counts_reach_the_full_scale() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_accel(c, 32767, -32768, 0)
    c.regs.insert(0x17, 0x03)
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 15990)
    test.assert_eq(y_of(lsm6dsv16x.accel_read_of(d)), -15990)

@test
fn test_a_rate_of_turn_is_converted_at_each_range() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // ±125 dps after a reset.
    put_gyro(c, 1000, -2000, 100)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 4375)
    test.assert_eq(gy_of(lsm6dsv16x.gyro_read_of(d)), -8750)
    test.assert_eq(gz_of(lsm6dsv16x.gyro_read_of(d)), 437)
    c.regs.insert(0x15, 0x01)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 8750)
    c.regs.insert(0x15, 0x02)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 17500)
    c.regs.insert(0x15, 0x03)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 35000)
    c.regs.insert(0x15, 0x04)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 70000)
    c.regs.insert(0x15, 0x0C)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 140000)

@test
fn test_each_sample_is_the_ranges_then_one_burst_of_the_outputs() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_accel(c, 1000, 0, 0)
    put_gyro(c, 1000, 0, 0)
    log_clear(c)
    let _a = lsm6dsv16x.accel_read_of(d)
    log_is(c, [2, 0x6A, 0x15, 3, -1, 2, 0x6A, 0x28, 6, -1])
    let _g = lsm6dsv16x.gyro_read_of(d)
    log_is(c, [2, 0x6A, 0x15, 3, -1, 2, 0x6A, 0x22, 6, -1])
    let _i = lsm6dsv16x.imu_read_of(d)
    log_is(c, [2, 0x6A, 0x15, 3, -1, 2, 0x6A, 0x22, 12, -1])

@test
fn test_a_paired_sample_has_both_from_one_burst_at_their_own_ranges() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put_gyro(c, 1000, -1000, 0)
    put_accel(c, 2000, 0, 1000)
    // The accelerometer at ±4 g and the gyroscope at ±500 dps.
    c.regs.insert(0x17, 0x01)
    c.regs.insert(0x15, 0x02)
    match lsm6dsv16x.imu_read_of(d)
        Some(s) =>
            test.assert_eq(s.accel.x, 244)
            test.assert_eq(s.accel.z, 122)
            test.assert_eq(s.gyro.x, 17500)
            test.assert_eq(s.gyro.y, -17500)
        None    => test.assert(false)

@test
fn test_a_sample_over_spi_is_the_same_burst() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    put_accel(c, 1000, 0, 0)
    put_gyro(c, 1000, 0, 0)
    log_clear(c)
    test.assert_eq(x_of(lsm6dsv16x.accel_read_of(d)), 61)
    log_is(c, [3, 0x95, 0xFF, 0xFF, 0xFF, -1, 3, 0xA8, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, -1])

@test
fn test_a_paired_sample_carries_the_die_temperature_of_the_same_burst() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    put16(c, 0x20, 256)
    put_gyro(c, 1000, -1000, 0)
    put_accel(c, 2000, 0, 1000)
    c.regs.insert(0x17, 0x01)
    c.regs.insert(0x15, 0x02)
    log_clear(c)
    match lsm6dsv16x.imu_read_temp_of(d)
        Some(s) =>
            test.assert_eq(s.accel.x, 244)
            test.assert_eq(s.accel.z, 122)
            test.assert_eq(s.gyro.x, 17500)
            test.assert_eq(s.gyro.y, -17500)
            test.assert_eq(s.temp.milli_c, 26000)
        None    => test.assert(false)
    // The ranges, then the temperature, the gyroscope and the accelerometer
    // in one burst of fourteen registers.
    log_is(c, [2, 0x6A, 0x15, 3, -1, 2, 0x6A, 0x20, 14, -1])
    // A part that does not answer, and one that goes quiet after the ranges.
    let e = chip()
    test.assert(lsm6dsv16x.imu_read_temp_of(flaky_read(e, 0x20, 1)) == None)
    c.st.insert(4, 0)
    test.assert(lsm6dsv16x.imu_read_temp_of(d) == None)

@test
fn test_no_part_gives_no_sample_and_is_never_ready() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.accel_read_of(d) == None)
    test.assert(lsm6dsv16x.gyro_read_of(d) == None)
    test.assert(lsm6dsv16x.imu_read_of(d) == None)
    test.assert(not lsm6dsv16x.accel_ready_of(d))
    test.assert(not lsm6dsv16x.gyro_ready_of(d))
    test.assert(lsm6dsv16x.temp_read_of(d) == None)
    // A part that answers the ranges and then goes quiet.
    let e = chip()
    test.assert(lsm6dsv16x.accel_read_of(flaky_read(e, 0x28, 1)) == None)
    test.assert(lsm6dsv16x.gyro_read_of(flaky_read(e, 0x22, 1)) == None)
    test.assert(lsm6dsv16x.imu_read_of(flaky_read(e, 0x22, 1)) == None)

@test
fn test_ready_is_xlda_and_gda_of_status_reg_and_reading_the_outputs_clears_them() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(not lsm6dsv16x.accel_ready_of(d))
    test.assert(not lsm6dsv16x.gyro_ready_of(d))
    c.st.insert(41, 1)
    test.assert(lsm6dsv16x.accel_ready_of(d))
    test.assert(not lsm6dsv16x.gyro_ready_of(d))
    c.st.insert(42, 1)
    test.assert(lsm6dsv16x.gyro_ready_of(d))
    let _ = lsm6dsv16x.accel_read_of(d)
    test.assert(not lsm6dsv16x.accel_ready_of(d))
    test.assert(lsm6dsv16x.gyro_ready_of(d))
    let _ = lsm6dsv16x.gyro_read_of(d)
    test.assert(not lsm6dsv16x.gyro_ready_of(d))

@test
fn test_the_temperature_is_256_counts_a_degree_from_25_degrees() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.temp_read_of(d) == Some(TempMilliC { milli_c: 25000 }))
    put16(c, 0x20, 256)
    test.assert(lsm6dsv16x.temp_read_of(d) == Some(TempMilliC { milli_c: 26000 }))
    put16(c, 0x20, -256)
    test.assert(lsm6dsv16x.temp_read_of(d) == Some(TempMilliC { milli_c: 24000 }))
    put16(c, 0x20, 128)
    test.assert(lsm6dsv16x.temp_read_of(d) == Some(TempMilliC { milli_c: 25500 }))
    put16(c, 0x20, 1)
    test.assert(lsm6dsv16x.temp_read_of(d) == Some(TempMilliC { milli_c: 25003 }))

