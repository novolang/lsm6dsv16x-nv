@test
fn test_a_range_is_changed_without_touching_the_other_bits() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x17, 0xE0)
    test.assert(lsm6dsv16x.accel_range_write(d, AccelRange8g))
    test.assert_eq(reg_of(c, 0x17), 0xE2)
    test.assert(lsm6dsv16x.accel_range_read(d) == AccelRange8g)
    test.assert(lsm6dsv16x.accel_range_write(d, AccelRange2g))
    test.assert_eq(reg_of(c, 0x17), 0xE0)
    c.regs.insert(0x15, 0x70)
    test.assert(lsm6dsv16x.gyro_range_write(d, GyroRange1000dps))
    test.assert_eq(reg_of(c, 0x15), 0x73)
    test.assert(lsm6dsv16x.gyro_range_read(d) == GyroRange1000dps)

@test
fn test_the_gyroscope_ranges_of_125_and_4000_dps_are_set_as_ranges() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x15, 0x71)
    test.assert(lsm6dsv16x.gyro_range_write(d, GyroRange4000dps))
    test.assert_eq(reg_of(c, 0x15), 0x7C)
    test.assert(lsm6dsv16x.gyro_range_read(d) == GyroRange4000dps)
    put_gyro(c, 1000, 0, 0)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 140000)
    test.assert(lsm6dsv16x.gyro_range_write(d, GyroRange125dps))
    test.assert_eq(reg_of(c, 0x15), 0x70)
    test.assert(lsm6dsv16x.gyro_range_read(d) == GyroRange125dps)
    test.assert_eq(gx_of(lsm6dsv16x.gyro_read_of(d)), 4375)
    // A range the part does not have is refused and the register stays.
    test.assert(not lsm6dsv16x.gyro_range_write(d, GyroRange62dps))
    test.assert(not lsm6dsv16x.gyro_range_write(d, GyroRange31dps))
    test.assert(not lsm6dsv16x.gyro_range_write(d, GyroRange15dps))
    test.assert_eq(reg_of(c, 0x15), 0x70)

@test
fn test_the_range_setters_answer_false_for_a_silent_part() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    let d = i2c_dut(c)
    test.assert(not lsm6dsv16x.accel_range_write(d, AccelRange4g))
    test.assert(not lsm6dsv16x.gyro_range_write(d, GyroRange500dps))
    test.assert(not lsm6dsv16x.gyro_range_write(d, GyroRange4000dps))
    test.assert(lsm6dsv16x.accel_range_read(d) == AccelRange2g)
    test.assert(lsm6dsv16x.gyro_range_read(d) == GyroRange250dps)

// ── Interrupt pins ───────────────────────────────────────────────────

@test
fn test_the_routes_are_int1_ctrl_and_int2_ctrl() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.int1_route(d, lsm6dsv16x.INT1_DRDY_XL | lsm6dsv16x.INT1_FIFO_TH))
    test.assert_eq(reg_of(c, 0x0D), 0x09)
    test.assert(lsm6dsv16x.int2_route(d, lsm6dsv16x.INT2_FIFO_FULL | lsm6dsv16x.INT2_FIFO_OVR))
    test.assert_eq(reg_of(c, 0x0E), 0x30)
    test.assert_eq(lsm6dsv16x.INT1_DRDY_G, 0x02)
    test.assert_eq(lsm6dsv16x.INT1_FIFO_OVR, 0x10)
    test.assert_eq(lsm6dsv16x.INT1_FIFO_FULL, 0x20)
    test.assert_eq(lsm6dsv16x.INT2_DRDY_XL, 0x01)
    test.assert_eq(lsm6dsv16x.INT2_DRDY_G, 0x02)
    test.assert_eq(lsm6dsv16x.INT2_FIFO_TH, 0x08)
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.int1_route(d, 1))
    test.assert(not lsm6dsv16x.int2_route(d, 1))

@test
fn test_the_pins_polarity_and_output_type_leave_the_other_bits() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x03, 0x80)
    test.assert(lsm6dsv16x.int_pins_config(d, true, false))
    test.assert_eq(reg_of(c, 0x03), 0x90)
    test.assert(lsm6dsv16x.int_pins_config(d, false, true))
    test.assert_eq(reg_of(c, 0x03), 0x88)
    test.assert(lsm6dsv16x.int_pins_config(d, true, true))
    test.assert_eq(reg_of(c, 0x03), 0x98)
    test.assert(lsm6dsv16x.int_pins_config(d, false, false))
    test.assert_eq(reg_of(c, 0x03), 0x80)

// ── The FIFO ─────────────────────────────────────────────────────────

@test
fn test_the_fifo_count_is_nine_bits_over_two_registers() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 0)
    c.regs.insert(0x0A, 0x06)
    for i in 0..300
        fifo_word(c, 2, i, 0, 0)
    log_clear(c)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 300)
    log_is(c, [2, 0x6A, 0x1B, 2, -1])
    c.st.insert(4, 0)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 0)

@test
fn test_the_fifo_is_started_in_bypass_then_configured_then_the_mode_is_written_last() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    c.regs.insert(0x11, 0x05)
    c.regs.insert(0x0D, 0x03)
    c.regs.insert(0x08, 0xFF)
    log_clear(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    test.assert_eq(reg_of(c, 0x0A), 0x06)
    test.assert_eq(reg_of(c, 0x07), 20)
    test.assert_eq(reg_of(c, 0x09), 0x56)
    // The compression bits are cleared, the reserved bits stay.
    test.assert_eq(reg_of(c, 0x08), 0x28)
    test.assert_eq(reg_of(c, 0x0D), 0x08)
    let seen = written(c)
    test.assert_eq(seen.len(), 6)
    test.assert_eq(seen[0], 0x0A)
    test.assert_eq(seen[1], 0x07)
    test.assert_eq(seen[2], 0x08)
    test.assert_eq(seen[3], 0x09)
    test.assert_eq(seen[4], 0x0D)
    test.assert_eq(seen[5], 0x0A)

@test
fn test_the_watermark_is_limited_to_1_to_255_and_the_gyroscope_is_optional() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    c.regs.insert(0x11, 0x05)
    test.assert(lsm6dsv16x.fifo_start(d, 500, false))
    test.assert_eq(reg_of(c, 0x07), 255)
    test.assert_eq(reg_of(c, 0x09), 0x06)
    test.assert(lsm6dsv16x.fifo_start(d, 0, true))
    test.assert_eq(reg_of(c, 0x07), 1)
    test.assert(d.setup())

@test
fn test_the_trait_configures_the_fifo_in_continuous_or_stop_mode() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    c.regs.insert(0x11, 0x05)
    test.assert(lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStream, 20))
    test.assert_eq(reg_of(c, 0x0A), 0x06)
    test.assert_eq(reg_of(c, 0x07), 20)
    test.assert_eq(reg_of(c, 0x09), 0x56)
    test.assert_eq(reg_of(c, 0x0D), 0x08)
    // The FIFO mode stops collecting when the FIFO is full: FIFO_MODE 001.
    test.assert(lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStop, 32))
    test.assert_eq(reg_of(c, 0x0A), 0x01)
    test.assert_eq(reg_of(c, 0x07), 32)
    // The gyroscope powered down is not batched.
    c.regs.insert(0x11, 0x00)
    test.assert(lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStream, 4))
    test.assert_eq(reg_of(c, 0x09), 0x06)
    // Off bypasses the FIFO and puts the data-ready flags back.
    test.assert(lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoOff, 0))
    test.assert_eq(reg_of(c, 0x0A), 0x00)
    test.assert_eq(reg_of(c, 0x09), 0x00)
    test.assert_eq(reg_of(c, 0x0D), 0x03)
    // A watermark outside 1 to 32 is refused and nothing is written.
    log_clear(c)
    test.assert(not lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStream, 0))
    test.assert(not lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStop, 33))
    log_is(c, [])
    // The read of the gyroscope's rate fails, and the part does not answer.
    let e = chip()
    test.assert(not lsm6dsv16x.fifo_configure(flaky_read(e, 0x11, 1), AccelFifoMode.AccelFifoStream, 8))
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStream, 8))

@test
fn test_the_fifo_watermark_is_the_flag_of_fifo_status2() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    test.assert(not lsm6dsv16x.fifo_watermark_reached(d))
    test.assert(lsm6dsv16x.fifo_configure(d, AccelFifoMode.AccelFifoStream, 2))
    test.assert(not lsm6dsv16x.fifo_watermark_reached(d))
    fifo_word(c, 2, 1, 2, 3)
    test.assert(not lsm6dsv16x.fifo_watermark_reached(d))
    fifo_word(c, 2, 1, 2, 3)
    test.assert(lsm6dsv16x.fifo_watermark_reached(d))
    // The flag is the part's level and the count is unchanged by the read.
    test.assert(lsm6dsv16x.fifo_watermark_reached(d))
    test.assert_eq(lsm6dsv16x.fifo_count(d), 2)
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.fifo_watermark_reached(d))

@test
fn test_a_fifo_start_that_a_register_refuses_fails() [io, hw]
    // The writes in order, as (register, which write of it).
    let regs = [0x0A, 0x07, 0x08, 0x09, 0x0D, 0x0A]
    let nth = [1, 1, 1, 1, 1, 2]
    for i in 0..regs.len()
        let f = flaky_write(chip(), regs[i], nth[i])
        test.assert(not lsm6dsv16x.fifo_start(f, 10, true))
    let g = chip()
    test.assert(not lsm6dsv16x.fifo_start(flaky_read(g, 0x10, 1), 10, true))
    let h = chip()
    h.st.insert(4, 0)
    test.assert(not lsm6dsv16x.fifo_start(i2c_dut(h), 10, true))

@test
fn test_the_fifo_is_stopped_emptied_and_the_data_ready_flags_come_back() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    fifo_word(c, 2, 1, 2, 3)
    test.assert(lsm6dsv16x.fifo_stop(d))
    test.assert_eq(reg_of(c, 0x0A), 0)
    test.assert_eq(reg_of(c, 0x09), 0)
    test.assert_eq(reg_of(c, 0x0D), 0x03)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 0)
    let regs = [0x0A, 0x09, 0x0D]
    for i in 0..regs.len()
        test.assert(not lsm6dsv16x.fifo_stop(flaky_write(chip(), regs[i], 1)))

@test
fn test_the_fifo_is_read_a_word_at_a_time_in_one_burst_of_seven() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x10, 0x06)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    fifo_word(c, 2, 1000, -2000, 10000)
    fifo_word(c, 2, 0, 0, 0)
    log_clear(c)
    var a: Vec[AccelMilliG; 32] = Vec.new()
    test.assert_eq(lsm6dsv16x.fifo_read(d, var a), 2)
    log_is(c, [2, 0x6A, 0x1B, 2, -1, 2, 0x6A, 0x17, 1, -1,
        2, 0x6A, 0x78, 7, -1, 2, 0x6A, 0x78, 7, -1])
    test.assert_eq(a.len(), 2)
    test.assert_eq(a[0].x, 61)
    test.assert_eq(a[0].y, -122)
    test.assert_eq(a[0].z, 610)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 0)

@test
fn test_both_sensors_words_alternate_and_other_tags_are_dropped() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    fifo_word(c, 1, 1000, 0, 0)
    fifo_word(c, 2, 1000, 0, 0)
    fifo_word(c, 3, 5, 5, 5)
    fifo_word(c, 1, 0, 2000, 0)
    fifo_word(c, 2, 0, 2000, 0)
    var a: Vec[AccelMilliG; 32] = Vec.new()
    var g: Vec[GyroMilliDps; 32] = Vec.new()
    // ±2 g and ±125 dps after a reset.
    test.assert_eq(lsm6dsv16x.fifo_read_imu(d, var a, var g), 5)
    test.assert_eq(a.len(), 2)
    test.assert_eq(g.len(), 2)
    test.assert_eq(a[0].x, 61)
    test.assert_eq(a[1].y, 122)
    test.assert_eq(g[0].x, 4375)
    test.assert_eq(g[1].y, 8750)
    // The accelerometer's reader drops the gyroscope's words.
    fifo_word(c, 1, 1000, 0, 0)
    fifo_word(c, 2, 1000, 0, 0)
    test.assert_eq(lsm6dsv16x.fifo_read(d, var a), 2)
    test.assert_eq(a.len(), 1)

@test
fn test_a_full_list_stops_the_read_without_taking_a_word_it_has_no_room_for() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    for i in 0..40
        fifo_word(c, 2, 1000, 0, 0)
    var a: Vec[AccelMilliG; 32] = Vec.new()
    var g: Vec[GyroMilliDps; 32] = Vec.new()
    test.assert_eq(lsm6dsv16x.fifo_read(d, var a), 32)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 8)
    for i in 0..40
        fifo_word(c, 1, 1000, 0, 0)
    // The 8 accelerometer words left come first, then 32 of the gyroscope's.
    test.assert_eq(lsm6dsv16x.fifo_read_imu(d, var a, var g), 40)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 8)
    var q: Vec[Lsm6dsv16xQuat; 32] = Vec.new()
    test.assert_eq(lsm6dsv16x.fifo_read_quat(d, var q), 8)
    // Forty quaternions fill the list at 32.
    for i in 0..40
        fifo_word(c, 0x13, 0x3800, 0x3800, 0x3800)
    test.assert_eq(lsm6dsv16x.fifo_read_quat(d, var q), 32)
    test.assert_eq(q.len(), 32)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 8)

@test
fn test_a_fifo_read_stops_when_the_part_goes_quiet() [io, hw]
    let c = chip()
    let f = flaky(c)
    test.assert(lsm6dsv16x.fifo_start(f, 20, true))
    for i in 0..3
        fifo_word(c, 2, 1000, 0, 0)
        fifo_word(c, 1, 1000, 0, 0)
    f.quiet.insert(1, 1)
    f.quiet.insert(0, 1)
    var a: Vec[AccelMilliG; 32] = Vec.new()
    var g: Vec[GyroMilliDps; 32] = Vec.new()
    var q: Vec[Lsm6dsv16xQuat; 32] = Vec.new()
    test.assert_eq(lsm6dsv16x.fifo_read(f, var a), 1)
    f.quiet.insert(0, 1)
    test.assert_eq(lsm6dsv16x.fifo_read_imu(f, var a, var g), 1)
    f.quiet.insert(0, 1)
    test.assert_eq(lsm6dsv16x.fifo_read_quat(f, var q), 1)
    // The reads before the words fail.
    let e = chip()
    let h = i2c_dut(e)
    test.assert(lsm6dsv16x.fifo_start(h, 20, true))
    fifo_word(e, 2, 1000, 0, 0)
    test.assert_eq(lsm6dsv16x.fifo_read(flaky_read(e, 0x17, 1), var a), 0)
    test.assert_eq(lsm6dsv16x.fifo_read_imu(flaky_read(e, 0x15, 1), var a, var g), 0)
    test.assert_eq(lsm6dsv16x.fifo_read(flaky_read(e, 0x1B, 1), var a), 0)
    test.assert_eq(lsm6dsv16x.fifo_read_imu(flaky_read(e, 0x1B, 1), var a, var g), 0)
    test.assert_eq(lsm6dsv16x.fifo_read_quat(flaky_read(e, 0x1B, 1), var q), 0)

// ── The game rotation vector ─────────────────────────────────────────

@test
fn test_a_half_precision_number_is_read_as_millionths() [io, hw]
    test.assert_eq(lsm6dsv16x.half_to_micro(0x0000), 0)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x3C00), 1000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0xBC00), -1000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x3800), 500000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0xB800), -500000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x3400), 250000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x3555), 333252)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x3E00), 1500000)
    // The subnormals: the largest is 0.0000610.
    test.assert_eq(lsm6dsv16x.half_to_micro(0x0001), 0)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x03FF), 61)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x8200), -31)
    // A magnitude of 2 or more is limited to 2, and the infinities and the
    // not-a-numbers are 0.
    test.assert_eq(lsm6dsv16x.half_to_micro(0x4000), 2000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x4400), 2000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x7BFF), 2000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0xFBFF), -2000000)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x7C00), 0)
    test.assert_eq(lsm6dsv16x.half_to_micro(0x7E00), 0)

@test
fn test_the_integer_square_root() [io, hw]
    test.assert_eq(lsm6dsv16x.isqrt(0), 0)
    test.assert_eq(lsm6dsv16x.isqrt(-4), 0)
    test.assert_eq(lsm6dsv16x.isqrt(1), 1)
    test.assert_eq(lsm6dsv16x.isqrt(15), 3)
    test.assert_eq(lsm6dsv16x.isqrt(16), 4)
    test.assert_eq(lsm6dsv16x.isqrt(1000000000000), 1000000)
    test.assert_eq(lsm6dsv16x.isqrt(999999999999), 999999)
    test.assert_eq(lsm6dsv16x.isqrt(3000000000000), 1732050)
    test.assert_eq(lsm6dsv16x.isqrt(17592186044415), 4194303)

@test
fn test_the_quaternion_is_x_y_z_from_halves_and_w_from_the_rest() [io, hw]
    let c = chip()
    var b: DevBytes = Vec.new()
    // x, y and z of 0.5, low byte first: w is 0.5.
    for v in [0x00, 0x38, 0x00, 0x38, 0x00, 0x38]
        let _ = b.push(v as u8)
    let q = lsm6dsv16x.quat_at(b, 0)
    test.assert_eq(q.x, 500000)
    test.assert_eq(q.y, 500000)
    test.assert_eq(q.z, 500000)
    test.assert_eq(q.w, 500000)
    // A unit rotation about z: (0, 0, 1), w = 0.
    var u: DevBytes = Vec.new()
    for v in [0x00, 0x00, 0x00, 0x00, 0x00, 0x3C]
        let _ = u.push(v as u8)
    let r = lsm6dsv16x.quat_at(u, 0)
    test.assert_eq(r.z, 1000000)
    test.assert_eq(r.w, 0)
    // A vector longer than 1 is scaled to length 1 and w is 0.
    var l: DevBytes = Vec.new()
    for v in [0x00, 0x3C, 0x00, 0x3C, 0x00, 0x3C]
        let _ = l.push(v as u8)
    let s = lsm6dsv16x.quat_at(l, 0)
    test.assert_eq(s.x, 577350)
    test.assert_eq(s.y, 577350)
    test.assert_eq(s.z, 577350)
    test.assert_eq(s.w, 0)
    // At an offset, with a negative component.
    var o: DevBytes = Vec.new()
    for v in [0xFF, 0x00, 0xB8, 0x00, 0x00, 0x00, 0x00]
        let _ = o.push(v as u8)
    let t = lsm6dsv16x.quat_at(o, 1)
    test.assert_eq(t.x, -500000)
    test.assert_eq(t.y, 0)
    test.assert_eq(t.w, 866025)
    test.assert(c.regs.len() > 0)

@test
fn test_the_fusion_block_is_enabled_in_the_embedded_bank_and_the_user_bank_comes_back() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x104, 0x88)
    test.assert(lsm6dsv16x.sflp_enable(d, true))
    test.assert_eq(emb_of(c, 0x04), 0x8A)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)
    test.assert(lsm6dsv16x.sflp_enable(d, false))
    test.assert_eq(emb_of(c, 0x04), 0x88)
    c.regs.insert(0x144, 0x20)
    test.assert(lsm6dsv16x.sflp_fifo_write(d, true))
    test.assert_eq(emb_of(c, 0x44), 0x22)
    test.assert(lsm6dsv16x.sflp_fifo_write(d, false))
    test.assert_eq(emb_of(c, 0x44), 0x20)
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.sflp_enable(d, true))
    test.assert(not lsm6dsv16x.sflp_fifo_write(d, true))

@test
fn test_the_fusion_rate_is_the_field_of_sflp_odr_and_leaves_the_fixed_bits() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // 120 Hz is the default: 0x5B.
    test.assert(lsm6dsv16x.sflp_rate_write(d, 0))
    test.assert_eq(emb_of(c, 0x5E), 0x43)
    test.assert(lsm6dsv16x.sflp_rate_write(d, 5))
    test.assert_eq(emb_of(c, 0x5E), 0x6B)
    test.assert(lsm6dsv16x.sflp_rate_write(d, 3))
    test.assert_eq(emb_of(c, 0x5E), 0x5B)
    test.assert(not lsm6dsv16x.sflp_rate_write(d, 6))
    test.assert(not lsm6dsv16x.sflp_rate_write(d, -1))
    test.assert_eq(emb_of(c, 0x5E), 0x5B)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)

@test
fn test_the_fusion_block_is_restarted_by_a_write_that_does_not_read_back() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.sflp_reset(d))
    test.assert_eq(emb_of(c, 0x66), 0x02)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)
    // The failures: the entry, the write, the exit.
    let e = chip()
    e.ro.insert(1, 1)
    test.assert(not lsm6dsv16x.sflp_reset(i2c_dut(e)))
    let f = chip()
    test.assert(not lsm6dsv16x.sflp_reset(flaky_write(f, 0x66, 1)))
    test.assert_eq(reg_of(f, 0x01) & 0xC0, 0)
    let g = chip()
    test.assert(not lsm6dsv16x.sflp_reset(flaky_write(g, 0x01, 2)))
    let h = chip()
    h.st.insert(4, 0)
    test.assert(not lsm6dsv16x.sflp_reset(i2c_dut(h)))

@test
fn test_the_game_rotation_vectors_come_out_of_the_fifo_as_quaternions() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    // A word of tag 0x13 with the halves 0.5, 0.5, 0.5; the accelerometer's
    // word between two is taken out and dropped.
    fifo_word(c, 0x13, 0x3800, 0x3800, 0x3800)
    fifo_word(c, 2, 1000, 0, 0)
    fifo_word(c, 0x13, 0x0000, 0x0000, 0x3C00)
    var q: Vec[Lsm6dsv16xQuat; 32] = Vec.new()
    test.assert_eq(lsm6dsv16x.fifo_read_quat(d, var q), 3)
    test.assert_eq(q.len(), 2)
    test.assert_eq(q[0].x, 500000)
    test.assert_eq(q[0].w, 500000)
    test.assert_eq(q[1].z, 1000000)
    test.assert_eq(q[1].w, 0)
    test.assert_eq(lsm6dsv16x.fifo_read_quat(d, var q), 0)

@test
fn test_fusion_is_enabled_with_its_words_in_a_fifo_that_runs() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.regs.insert(0x104, 0x88)
    c.regs.insert(0x144, 0x20)
    // The FIFO is in bypass: it is started in continuous mode.
    test.assert(lsm6dsv16x.fusion_enable(d, true))
    test.assert_eq(emb_of(c, 0x04), 0x8A)
    test.assert_eq(emb_of(c, 0x44), 0x22)
    test.assert_eq(reg_of(c, 0x0A) & 0x07, 0x06)
    test.assert_eq(reg_of(c, 0x01) & 0xC0, 0)
    // A FIFO that runs is left as it is.
    c.regs.insert(0x0A, 0x01)
    test.assert(lsm6dsv16x.fusion_enable(d, true))
    test.assert_eq(reg_of(c, 0x0A) & 0x07, 0x01)
    // Off stops the block and takes its words out; the FIFO mode stays.
    test.assert(lsm6dsv16x.fusion_enable(d, false))
    test.assert_eq(emb_of(c, 0x04), 0x88)
    test.assert_eq(emb_of(c, 0x44), 0x20)
    test.assert_eq(reg_of(c, 0x0A) & 0x07, 0x01)
    // Each step that the part refuses fails the call.
    let e = chip()
    test.assert(not lsm6dsv16x.fusion_enable(flaky_write(e, 0x04, 1), true))
    let f = chip()
    test.assert(not lsm6dsv16x.fusion_enable(flaky_write(f, 0x44, 1), true))
    let g = chip()
    test.assert(not lsm6dsv16x.fusion_enable(flaky_read(g, 0x0A, 1), true))
    let h = chip()
    test.assert(not lsm6dsv16x.fusion_enable(flaky_write(h, 0x0A, 1), true))
    let i = chip()
    i.st.insert(4, 0)
    test.assert(not lsm6dsv16x.fusion_enable(i2c_dut(i), true))

@test
fn test_the_orientation_is_the_newest_rotation_vector_as_a_q30_quaternion() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    test.assert(lsm6dsv16x.fifo_start(d, 20, true))
    // Nothing in the FIFO: no orientation.
    test.assert(lsm6dsv16x.orientation_read(d) == None)
    // Two vectors with a word of the accelerometer between: the newest wins
    // and the FIFO is empty after.
    fifo_word(c, 0x13, 0x3800, 0x3800, 0x3800)
    fifo_word(c, 2, 1000, 0, 0)
    fifo_word(c, 0x13, 0x0000, 0x0000, 0x3C00)
    match lsm6dsv16x.orientation_read(d)
        Some(q) =>
            test.assert_eq(q.x, 0)
            test.assert_eq(q.y, 0)
            test.assert_eq(q.z, dev_imu.IMU_QUAT_ONE)
            test.assert_eq(q.w, 0)
        None    => test.assert(false)
    test.assert_eq(lsm6dsv16x.fifo_count(d), 0)
    // A vector of 0.5, 0.5, 0.5 and w of 0.5 is half in Q30.
    fifo_word(c, 0x13, 0x3800, 0x3800, 0x3800)
    match lsm6dsv16x.orientation_read(d)
        Some(q) =>
            test.assert_eq(q.x, dev_imu.IMU_QUAT_ONE / 2)
            test.assert_eq(q.w, dev_imu.IMU_QUAT_ONE / 2)
        None    => test.assert(false)
    // A FIFO with the sensors' words alone gives no orientation.
    fifo_word(c, 2, 1000, 0, 0)
    test.assert(lsm6dsv16x.orientation_read(d) == None)
    c.st.insert(4, 0)
    test.assert(lsm6dsv16x.orientation_read(d) == None)

// ── Self-test ────────────────────────────────────────────────────────

@test
fn test_the_accelerometer_self_test_is_on_minus_off_and_puts_the_settings_back() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.st.insert(43, 1)
    c.st.insert(30, 1000)
    c.st.insert(31, 2000)
    c.st.insert(32, 3000)
    put_accel(c, 100, 200, 300)
    c.regs.insert(0x10, 0x56)
    c.regs.insert(0x17, 0x03)
    c.regs.insert(0x12, 0x04)
    log_clear(c)
    // ±4 g, 122 ug a count; the positive push is added.
    match lsm6dsv16x.accel_self_test(d, false)
        Some(r) =>
            test.assert_eq(r.x, 122)
            test.assert_eq(r.y, 244)
            test.assert_eq(r.z, 366)
        None    => test.assert(false)
    test.assert_eq(reg_of(c, 0x19), 0)
    test.assert_eq(reg_of(c, 0x10), 0x56)
    test.assert_eq(reg_of(c, 0x17), 0x03)
    test.assert_eq(reg_of(c, 0x12) & 0x40, 0x40)
    // The negative test takes the push away.
    match lsm6dsv16x.accel_self_test(d, true)
        Some(r) =>
            test.assert_eq(r.x, -121)
            test.assert_eq(r.z, -365)
        None    => test.assert(false)
    // Two settling waits of 100 ms each time.
    test.assert_eq(at(c.st, 50), 400000)

@test
fn test_the_gyroscope_self_test_is_on_minus_off_and_negative_is_the_other_sign() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    c.st.insert(43, 1)
    c.st.insert(33, 10000)
    c.st.insert(34, 0)
    c.st.insert(35, 5000)
    c.regs.insert(0x11, 0x05)
    c.regs.insert(0x15, 0x02)
    // ±2000 dps, 70 mdps a count.
    match lsm6dsv16x.gyro_self_test(d, false)
        Some(r) =>
            test.assert_eq(r.x, 700000)
            test.assert_eq(r.y, 0)
            test.assert_eq(r.z, 350000)
        None    => test.assert(false)
    test.assert_eq(reg_of(c, 0x19), 0)
    test.assert_eq(reg_of(c, 0x11), 0x05)
    test.assert_eq(reg_of(c, 0x15), 0x02)
    match lsm6dsv16x.gyro_self_test(d, true)
        Some(r) => test.assert_eq(r.x, -700000)
        None    => test.assert(false)
    test.assert(d.setup())

@test
fn test_a_self_test_gives_none_when_a_step_fails_and_still_restores() [io, hw]
    // The writes in order: BDU, the range, the rate, then the self-test.
    let regs = [0x12, 0x17, 0x10, 0x19]
    for i in 0..regs.len()
        let c = chip()
        c.st.insert(43, 1)
        put_accel(c, 1, 2, 3)
        test.assert(lsm6dsv16x.accel_self_test(flaky_write(c, regs[i], 1), false) == None)
        test.assert_eq(reg_of(c, 0x19), 0)
    let gregs = [0x12, 0x15, 0x11, 0x19]
    for i in 0..gregs.len()
        let e = chip()
        e.st.insert(43, 1)
        test.assert(lsm6dsv16x.gyro_self_test(flaky_write(e, gregs[i], 1), false) == None)
        test.assert_eq(reg_of(e, 0x19), 0)
    // The reads of the settings, and of the part that does not answer.
    let f = chip()
    test.assert(lsm6dsv16x.accel_self_test(flaky_read(f, 0x10, 1), false) == None)
    test.assert(lsm6dsv16x.accel_self_test(flaky_read(f, 0x17, 1), false) == None)
    test.assert(lsm6dsv16x.gyro_self_test(flaky_read(f, 0x11, 1), false) == None)
    test.assert(lsm6dsv16x.gyro_self_test(flaky_read(f, 0x15, 1), false) == None)

@test
fn test_a_self_test_gives_none_when_a_sample_never_comes() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // No new-data flag: the polls give out.
    test.assert(lsm6dsv16x.accel_self_test(d, false) == None)
    test.assert(lsm6dsv16x.gyro_self_test(d, false) == None)
    // The off mean comes, the on mean does not: the grants run out.
    let f = chip()
    f.st.insert(43, 1)
    f.st.insert(45, 1)
    f.st.insert(44, 8)
    test.assert(lsm6dsv16x.accel_self_test(i2c_dut(f), false) == None)
    test.assert_eq(reg_of(f, 0x19), 0)
    let g = chip()
    g.st.insert(43, 1)
    g.st.insert(45, 1)
    g.st.insert(44, 8)
    test.assert(lsm6dsv16x.gyro_self_test(i2c_dut(g), false) == None)
    // A sample whose read fails after the flag came.
    let h = chip()
    h.st.insert(43, 1)
    test.assert(lsm6dsv16x.accel_self_test(flaky_read(h, 0x28, 1), false) == None)
    test.assert(lsm6dsv16x.gyro_self_test(flaky_read(h, 0x22, 1), false) == None)

@test
fn test_the_self_test_limits_are_table_3s_by_magnitude() [io, hw]
    test.assert(lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 50, y: -1700, z: 800 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 49, y: 800, z: 800 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 1701, y: 800, z: 800 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 800, y: 49, z: 800 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 800, y: 1701, z: 800 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 800, y: 800, z: 49 }))
    test.assert(not lsm6dsv16x.accel_self_test_within(AccelMilliG { x: 800, y: 800, z: -1701 }))
    test.assert(lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 150000, y: -700000, z: 400000 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 149999, y: 400000, z: 400000 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 700001, y: 400000, z: 400000 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 400000, y: 149999, z: 400000 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 400000, y: 700001, z: 400000 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 400000, y: 400000, z: 149999 }))
    test.assert(not lsm6dsv16x.gyro_self_test_within(GyroMilliDps { x: 400000, y: 400000, z: 700001 }))

// ── Bring-up ─────────────────────────────────────────────────────────

@test
fn test_begin_over_i2c_resets_and_sets_the_part_up() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    // A part left in the embedded bank and with stale settings.
    c.regs.insert(0x01, 0x80)
    c.regs.insert(0x03, 0x18)
    test.assert(lsm6dsv16x.start(d))
    test.assert_eq(reg_of(c, 0x01), 0x00)
    test.assert_eq(reg_of(c, 0x12), 0x44)
    test.assert_eq(reg_of(c, 0x03), 0x00)
    test.assert_eq(reg_of(c, 0x13), 0x08)
    test.assert_eq(reg_of(c, 0x17), 0x00)
    test.assert_eq(reg_of(c, 0x15), 0x01)
    test.assert_eq(reg_of(c, 0x0D), 0x03)
    test.assert_eq(reg_of(c, 0x11), 0x06)
    test.assert_eq(reg_of(c, 0x10), 0x06)
    test.assert_eq(at(c.st, 22), 400000)
    // The global reset and the gyroscope's turn-on, 30 ms each.
    test.assert_eq(at(c.st, 50), 60000)
    test.assert_eq(lsm6dsv16x.accel_rate_read(d), 120000)
    test.assert_eq(lsm6dsv16x.gyro_rate_read(d), 120000)

@test
fn test_begin_over_spi_turns_the_i2c_block_off() [io, hw]
    let c = chip()
    let d = spi_dut(c)
    test.assert(lsm6dsv16x.start(d))
    test.assert_eq(reg_of(c, 0x03), 0x01)
    test.assert_eq(at(c.st, 20), 4000000)
    test.assert_eq(at(c.st, 21), 3)

@test
fn test_begin_resets_with_sw_por_after_the_id_check() [io, hw]
    let c = chip()
    let d = i2c_dut(c)
    log_clear(c)
    test.assert(lsm6dsv16x.start(d))
    // FUNC_CFG_ACCESS written and read back, WHO_AM_I read, then the reset
    // write of SW_POR.
    test.assert_eq(at(c.log, 0), 1)
    test.assert_eq(at(c.log, 2), 0x01)
    test.assert_eq(at(c.log, 3), 0x00)
    test.assert_eq(at(c.log, 5), 2)
    test.assert_eq(at(c.log, 7), 0x01)
    test.assert_eq(at(c.log, 10), 2)
    test.assert_eq(at(c.log, 12), 0x0F)
    test.assert_eq(at(c.log, 15), 1)
    test.assert_eq(at(c.log, 17), 0x01)
    test.assert_eq(at(c.log, 18), 0x04)

@test
fn test_begin_refuses_a_part_that_is_not_there_or_not_an_lsm6dsv16x() [io, hw]
    let c = chip()
    c.st.insert(4, 0)
    test.assert(not lsm6dsv16x.start(i2c_dut(c)))
    // The LSM6DSO answers 0x6C.
    let d = chip()
    d.regs.insert(0x0F, 0x6C)
    test.assert(not lsm6dsv16x.start(i2c_dut(d)))
    let e = chip()
    test.assert(not lsm6dsv16x.start(I2cDut { bus: FakeI2c { c: e }, pins: pins(e), w: dev_bus.wiring_spi(0, 67) }))
    let f = chip()
    test.assert(not lsm6dsv16x.start(flaky_read(f, 0x0F, 1)))

@test
fn test_begin_refuses_a_write_the_part_does_not_take() [io, hw]
    // The writes of `start` over I2C in order, as (register, which write of
    // it).
    let regs = [0x01, 0x01, 0x12, 0x13, 0x17, 0x15, 0x0D, 0x11, 0x10]
    let nth = [1, 2, 1, 1, 1, 1, 1, 1, 1]
    for i in 0..regs.len()
        let f = flaky_write(chip(), regs[i], nth[i])
        test.assert(not lsm6dsv16x.start(f))
        test.assert(at(f.seen, regs[i]) >= nth[i])

@test
fn test_begin_over_spi_refuses_the_interface_write_the_part_does_not_take() [io, hw]
    let c = chip()
    c.ro.insert(3, 1)
    test.assert(not lsm6dsv16x.start(spi_dut(c)))

// ── The types over the host's board handles ──────────────────────────
//
// The host's handles are absent hardware: every transfer is refused, so
// each method answers its "no part" value.  This runs the lines of the
// two types that forward to the functions above.

@test
fn test_the_i2c_type_over_absent_hardware() [io, hw]
    let w = dev_bus.wiring_i2c(0, 0x6A)
    let p = Lsm6dsv16x.attach(BoardI2c { id: 0 }, BoardGpio { id: 0 }, w)
    p.wait_us(10)
    test.assert(not p.begin())
    test.assert(p.reg(0x0F) == None)
    test.assert(not p.set_reg(0x10, 1))
    test.assert(p.emb_reg(0x5E) == None)
    test.assert(not p.set_emb_reg(0x5E, 0x38, 0x10))
    test.assert_eq(p.gyro_set_rate_hz(120), 0)
    test.assert_eq(p.accel_rate_mhz(), -1)
    test.assert_eq(p.accel_set_rate_mhz(120000), -1)
    test.assert_eq(p.gyro_rate_mhz(), -1)
    test.assert_eq(p.set_gyro_rate_mhz(120000), -1)
    test.assert(not p.gyro_set_range(GyroRange4000dps))
    test.assert(p.accel_mode() == None)
    test.assert(not p.accel_set_mode(AccelMode.AccelLowPower))
    test.assert(not p.set_accel_lp(4))
    test.assert(p.gyro_mode() == Lsm6dsv16xMode.Lsm6dsv16xHighPerf)
    test.assert(not p.set_gyro_mode(Lsm6dsv16xMode.Lsm6dsv16xLowPower))
    test.assert(not p.set_ha_series(1))
    test.assert(not p.route_int1(3))
    test.assert(not p.route_int2(3))
    test.assert(not p.configure_pins(true, false))
    test.assert(not p.accel_fifo_config(AccelFifoMode.AccelFifoStream, 10))
    test.assert(not p.accel_fifo_watermark_reached())
    test.assert(not p.fifo_end())
    var a: Vec[AccelMilliG; 32] = Vec.new()
    var g: Vec[GyroMilliDps; 32] = Vec.new()
    var q: Vec[Lsm6dsv16xQuat; 32] = Vec.new()
    test.assert_eq(p.fifo_take_imu(var a, var g), 0)
    test.assert_eq(p.fifo_take_quat(var q), 0)
    test.assert(not p.imu_fusion_enable(true))
    test.assert(p.imu_orientation() == None)
    test.assert(p.imu_read_temp() == None)
    test.assert(not p.set_fusion_rate(3))
    test.assert(not p.set_fusion_fifo(true))
    test.assert(not p.reset_fusion())
    test.assert(p.accel_test(false) == None)
    test.assert(p.gyro_test(false) == None)
    test.assert_eq(p.irq_level(), -1)
    test.assert(not p.on_spi())
    test.assert(p.accel_read() == None)
    test.assert(not p.accel_ready())
    test.assert(p.accel_range() == AccelRange2g)
    test.assert(not p.accel_set_range(AccelRange4g))
    test.assert_eq(p.accel_rate_hz(), 0)
    test.assert_eq(p.accel_set_rate_hz(100), 0)
    test.assert_eq(p.accel_fifo_count(), 0)
    test.assert_eq(p.accel_fifo_read(var a), 0)
    test.assert(p.gyro_read() == None)
    test.assert(not p.gyro_ready())
    test.assert(p.gyro_range() == GyroRange250dps)
    test.assert(not p.gyro_set_range(GyroRange500dps))
    test.assert_eq(p.gyro_rate_hz(), 0)
    test.assert(p.imu_read() == None)
    test.assert_eq(p.temp_start(), 0)
    test.assert(p.temp_read() == None)
    test.assert(p.device_id() == None)
    test.assert(not p.device_probe(0x70))

@test
fn test_the_spi_type_over_absent_hardware() [io, hw]
    let w = DeviceWiring { bus: 0, addr: None, cs: None, irq: None, en: None }
    let p = Lsm6dsv16xSpi.attach(BoardSpi { id: 0 }, BoardGpio { id: 0 }, w)
