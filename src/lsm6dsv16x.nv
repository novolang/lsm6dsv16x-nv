// lsm6dsv16x — ST's LSM6DSV16X six-axis inertial module, on its I2C or its
// SPI bus, as devices-nv's `Accelerometer`, `Gyroscope`, `Imu`,
// `Thermometer` and `Identifiable`, with the sensor fusion low-power block's
// game rotation vector as an option.
//
// The facts below are from ST's data sheet "LSM6DSV16X: 6-axis IMU with
// embedded sensor fusion, AI, Qvar for high-end applications", document
// DS13510, revision 3 (March 2023); its sections and tables are named by
// number.  The register addresses and field positions are checked against
// ST's platform-independent driver `lsm6dsv16x_reg` (`lsm6dsv16x-pid`).
// Where the sheet and the drivers read for this one disagree, the site says
// which was taken.
//
// The register map (§ 9), as this driver uses it:
//
//   0x01  FUNC_CFG_ACCESS  EMB_FUNC_REG_ACCESS (7), SHUB_REG_ACCESS (6),
//                          SW_POR (2)
//   0x03  IF_CFG           H_LACTIVE (4), PP_OD (3), SIM (2),
//                          I2C_I3C_disable (0); not reset by SW_RESET
//   0x07  FIFO_CTRL1       WTM[7:0]
//   0x08  FIFO_CTRL2       STOP_ON_WTM (7), FIFO_COMPR_RT_EN (6),
//                          ODR_CHG_EN (4), UNCOMPR_RATE (2:1)
//   0x09  FIFO_CTRL3       BDR_GY (7:4), BDR_XL (3:0)
//   0x0A  FIFO_CTRL4       FIFO_MODE (2:0)
//   0x0D  INT1_CTRL        INT1_FIFO_FULL (5), INT1_FIFO_OVR (4),
//                          INT1_FIFO_TH (3), INT1_DRDY_G (1),
//                          INT1_DRDY_XL (0)
//   0x0E  INT2_CTRL        the same, and INT2_DRDY_G_EIS (2)
//   0x0F  WHO_AM_I         0x70
//   0x10  CTRL1            OP_MODE_XL (6:4), ODR_XL (3:0)
//   0x11  CTRL2            OP_MODE_G (6:4), ODR_G (3:0)
//   0x12  CTRL3            BOOT (7), BDU (6), IF_INC (2), SW_RESET (0)
//   0x13  CTRL4            INT2_on_INT1 (4), DRDY_MASK (3), INT2_DRDY_TEMP
//                          (2), DRDY_PULSED (1), INT2_IN_LH (0)
//   0x15  CTRL6            LPF1_G_BW (6:4), FS_G (3:0)
//   0x17  CTRL8            HP_LPF2_XL_BW (7:5), FS_XL (1:0)
//   0x19  CTRL10           ST_G (3:2), ST_XL (1:0)
//   0x1B  FIFO_STATUS1     DIFF_FIFO[7:0]
//   0x1C  FIFO_STATUS2     FIFO_WTM_IA (7), FIFO_OVR_IA (6), FIFO_FULL_IA
//                          (5), DIFF_FIFO[8] (0)
//   0x1E  STATUS_REG       TDA (2), GDA (1), XLDA (0)
//   0x20  OUT_TEMP_L, 0x21 OUT_TEMP_H
//   0x22  OUTX_L_G to 0x27 OUTZ_H_G, then 0x28 OUTX_L_A to 0x2D OUTZ_H_A:
//         each axis a 16-bit two's complement count, low byte first
//   0x62  HAODR_CFG        HAODR_SEL (1:0)
//   0x78  FIFO_DATA_OUT_TAG, 0x79 to 0x7E the six data bytes of a word
//
// The embedded functions bank (reached with FUNC_CFG_ACCESS):
//
//   0x04  EMB_FUNC_EN_A    SFLP_GAME_EN (1)
//   0x44  EMB_FUNC_FIFO_EN_A  SFLP_GAME_FIFO_EN (1)
//   0x5E  SFLP_ODR         SFLP_GAME_ODR (5:3)
//   0x66  EMB_FUNC_INIT_A  SFLP_GAME_INIT (1)
//
// The step.  Table 3 gives 0.061, 0.122, 0.244 and 0.488 mg per count for ±2,
// ±4, ±8 and ±16 g, and 4.375, 8.75, 17.5, 35, 70 and 140 mdps per count for
// ±125, ±250, ±500, ±1000, ±2000 and ±4000 dps.  The driver converts in
// integer micro-units: 61, 122, 244 and 488 ug and 4375, 8750, 17500,
// 35000, 70000 and 140000 udps per count.
//
// The output data rates (Tables 52, 55 and 20).  Codes 0010 to 1100 are 7.5,
// 15, 30, 60, 120, 240, 480, 960, 1920, 3840 and 7680 Hz; the accelerometer
// has 1.875 Hz as code 0001; 0000 is power-down.  In high-accuracy ODR mode
// the rates of codes 0011 to 1100 follow HAODR_SEL: 00 the rates above, 01
// 15.625 Hz and its doublings up to 8000 Hz, 10 12.5 Hz and its doublings up
// to 6400 Hz.  Each sensor has its own operating mode in OP_MODE: high
// performance (all rates from 7.5 Hz), high-accuracy ODR, low power (the
// accelerometer 1.875 Hz and 15 to 240 Hz, in three averaging steps; the
// gyroscope 7.5 to 240 Hz) and, for the accelerometer, normal mode (7.5 Hz to
// 1.92 kHz).  High-accuracy ODR mode has to be entered and left with the
// sensor in power-down, and when it is used for one sensor the other has to
// be in it too (§ 6.5).
//
// The two buses.  On I2C the part answers at 0x6A (SDO/SA0 low) or 0x6B
// (high).  On SPI a transaction is a control byte, then data, inside one
// chip-select window: bit 7 is R/W (1 reads), bits 6 to 0 the register,
// with no dummy byte (§ 5.1.3).  The register address advances after each
// byte of a multiple-byte transfer on both buses only while IF_INC (CTRL3
// bit 2) is set, which it is after a reset.  The part takes SPI mode 0 or 3.
// IF_CFG is not reset by SW_RESET, so `start` resets the part with SW_POR.
//
// Drivers read for their fixes, nothing ported: ST's `lsm6dsv16x_reg` driver
// with its examples `lsm6dsv16x_self_test` and `lsm6dsv16x_sensor_fusion`,
// Zephyr's `drivers/sensor/st/lsm6dsv16x`, and the Rust crate
// `lsm6dsv16x-rs`, which wraps ST's driver.  Each fix kept is named at its
// site.
//
// The driver holds no state: the full scales and the modes are read from
// the part in the transaction before the sample.
//
// A bus enters through `Lsm6dsv16xPort`, which a type that holds a bus
// implements: `Lsm6dsv16x` for an I2C bus and `Lsm6dsv16xSpi` for an SPI
// bus.  The framing of each bus is the generic functions `i2c_read_into`,
// `i2c_write`, `spi_read_into` and `spi_write`, so a test runs them over a
// double of the bus.

use embedded_hal.{ BoardI2c, BoardSpi, BoardGpio, BoardTimer, I2cBus, SpiBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_accel.{ AccelMilliG, AccelRange, Accelerometer }
use dev_gyro.{ GyroMilliDps, GyroRange, Gyroscope }
use dev_imu.{ ImuSample, Imu }
use dev_thermo.{ TempMilliC, Thermometer }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let FUNC_CFG_ACCESS   = 0x01
let IF_CFG            = 0x03
let FIFO_CTRL1        = 0x07
let FIFO_CTRL2        = 0x08
let FIFO_CTRL3        = 0x09
let FIFO_CTRL4        = 0x0A
let INT1_CTRL         = 0x0D
let INT2_CTRL         = 0x0E
let WHO_AM_I          = 0x0F
let CTRL1             = 0x10
let CTRL2             = 0x11
let CTRL3             = 0x12
let CTRL4             = 0x13
let CTRL6             = 0x15
let CTRL8             = 0x17
let CTRL10            = 0x19
let FIFO_STATUS1      = 0x1B
let STATUS_REG        = 0x1E
let OUT_TEMP_L        = 0x20
let OUTX_L_G          = 0x22
let OUTX_L_A          = 0x28
let HAODR_CFG         = 0x62
let FIFO_DATA_OUT_TAG = 0x78

// The embedded functions bank.
let EMB_FUNC_EN_A      = 0x04
let EMB_FUNC_FIFO_EN_A = 0x44
let SFLP_ODR           = 0x5E
let EMB_FUNC_INIT_A    = 0x66

// WHO_AM_I's value.
let ID_LSM6DSV16X = 0x70

// The SPI control byte's R/W bit.
let SPI_READ = 0x80

// FUNC_CFG_ACCESS: the embedded bank, the sensor hub bank and the reset.
let FCA_EMB_BANK  = 0x80
let FCA_BANK_MASK = 0xC0
let FCA_SW_POR    = 0x04
// IF_CFG: the interrupt polarity and output type, and the I2C block off.
let IF_H_LACTIVE   = 0x10
let IF_PP_OD       = 0x08
let IF_I2C_DISABLE = 0x01
// CTRL3: block data update and the register address increment.
let C3_BDU    = 0x40
let C3_IF_INC = 0x04
// CTRL4: data-ready masked until the filters settle.
let C4_DRDY_MASK = 0x08
// CTRL10: the self-test fields.
let C10_ST_XL_MASK = 0x03
let C10_ST_G_MASK  = 0x0C
let C10_ST_XL_POS  = 0x01
let C10_ST_XL_NEG  = 0x02
let C10_ST_G_POS   = 0x04
let C10_ST_G_NEG   = 0x08
// STATUS_REG: the new-data flags.
let ST_XLDA = 0x01
let ST_GDA  = 0x02
// FIFO_CTRL4: bypass and continuous mode.
let FIFO_BYPASS     = 0x00
let FIFO_CONTINUOUS = 0x06
// FIFO tags: the gyroscope, the accelerometer and the game rotation vector.
let TAG_GYRO      = 1
let TAG_ACCEL     = 2
let TAG_SFLP_GAME = 0x13
// The most the watermark takes, in words.
let FIFO_WTM_MAX = 255
// The most samples the driver moves out of the FIFO into one list.
let LIST_DEPTH = 32

// The temperature sensor: 256 counts per degree, 0 at 25 °C (Table 6).
let TEMP_COUNTS_PER_C = 256
let TEMP_ZERO_MC      = 25000

// The ODR codes `start` sets: 120 Hz for both sensors.
let ODR_120 = 6

// The clocks `setup` asks for: I2C fast mode, and SPI at 4 MHz in mode 3.
let I2C_HZ   = 400000
let SPI_HZ   = 4000000
let SPI_MODE = 3

// The waits.  A global reset takes 30 ms (Zephyr, from AN5763), the
// gyroscope turns on in 30 ms (Table 4), and ST's self-test example waits
// 100 ms for the output to settle.
let WAIT_RESET_US   = 30000
let WAIT_GYRO_US    = 30000
let WAIT_SETTLE_US  = 100000
let SELF_TEST_POLLS = 4000

// The self-test procedure of ST's `lsm6dsv16x_self_test` example: the
// accelerometer at 60 Hz and ±4 g, the gyroscope at 240 Hz and ±2000 dps; one
// sample passed after the settling, and five averaged.
let XL_ST_ODR  = 5
let XL_ST_FS   = 1
let G_ST_ODR   = 7
let G_ST_FS    = 4
let ST_SKIP    = 1
let ST_AVERAGE = 5

// INT1_CTRL and INT2_CTRL's bits for `int_route`.

// The accelerometer's data-ready flag on INT1.
pub const INT1_DRDY_XL = 0x01

// The gyroscope's data-ready flag on INT1.
pub const INT1_DRDY_G = 0x02

// The FIFO watermark on INT1.
pub const INT1_FIFO_TH = 0x08

// The FIFO overrun flag on INT1.
pub const INT1_FIFO_OVR = 0x10

// The FIFO-full flag on INT1.
pub const INT1_FIFO_FULL = 0x20

// The accelerometer's data-ready flag on INT2.
pub const INT2_DRDY_XL = 0x01

// The gyroscope's data-ready flag on INT2.
pub const INT2_DRDY_G = 0x02

// The FIFO watermark on INT2.
pub const INT2_FIFO_TH = 0x08

// The FIFO overrun flag on INT2.
pub const INT2_FIFO_OVR = 0x10

// The FIFO-full flag on INT2.
pub const INT2_FIFO_FULL = 0x20

// The operating mode of a sensor (§§ 6.2 and 6.4): high performance at
// every rate, high-accuracy ODR, low power at the lower rates, and, for the
// accelerometer, normal mode.
pub @value
enum Lsm6dsv16xMode
    Lsm6dsv16xHighPerf
    Lsm6dsv16xHighAccuracy
    Lsm6dsv16xLowPower
    Lsm6dsv16xNormal

// A unit quaternion in millionths: 1,000,000 is 1.0.  The game rotation
// vector of the sensor fusion low-power block, the attitude of the device
// without a heading.
pub @value
struct Lsm6dsv16xQuat
    x: Int
    y: Int
    z: Int
    w: Int

// A bus the part is on.  `setup` makes the bus and the pins ready and
// answers whether the wiring suits the bus; `read_regs` reads `n`
// registers from `reg` in one transaction; `write_reg` writes one
// register; `irq_level` answers the level of the INT1 pin; `on_spi`
// answers whether the bus is SPI, which turns the I2C block off; `wait_us`
// waits.
pub trait Lsm6dsv16xPort
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
    fn irq_level(self) -> Int [hw]
    fn on_spi(self) -> Bool [hw]
    fn wait_us(self, us: Int) [hw]

// ── The two buses ────────────────────────────────────────────────────

// Reads `n` registers from `reg` into `dst` in one I2C transaction, a
// write of the register and a repeated start: whether the part answered.
// The address advances while IF_INC is set.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes `v` to the register `reg` in one I2C transaction: whether the
// part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    dev_bus.wiring_write_from(bus, w, reg, src)

// Reads `n` registers from `reg` into `dst` in one SPI transaction: the
// control byte with R/W set, then the data, which the part shifts out with
// no dummy byte in between.  Whether it ran, which is whether the wiring
// has a chip select.
pub fn spi_read_into<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int, n: Int,
                                            var dst: DevBytes) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((SPI_READ | (reg & 0x7F)) as u8)
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, n, var dst)

// Writes `v` to the register `reg` in one SPI transaction, R/W clear:
// whether it ran.
pub fn spi_write<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring, reg: Int,
                                        v: Int) -> Bool [hw]
    var tx: DevBytes = Vec.new()
    let _ = tx.push((reg & 0x7F) as u8)
    let _ = tx.push((v & 0xFF) as u8)
    var none: DevBytes = Vec.new()
    dev_bus.wiring_spi_exchange_into(bus, gpio, w, tx, 0, var none)

// Makes an I2C bus ready: the INT1 pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(I2C_HZ)
    w.addr != None

// Makes an SPI bus ready: chip select driven high first, so the pin never
// drives low before it is an output, then an output; the INT1 pin an input;
// the bus at 4 MHz in mode 3.  Answers whether the wiring has a chip
// select.
pub fn spi_setup<B: SpiBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    let Some(cs) = w.cs else return false
    gpio.set(cs, 1)
    gpio.mode(cs, 1)
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    bus.init(SPI_HZ, SPI_MODE)
    true

// The level of the part's INT1 line on the board, 1 or 0, or -1 for a
// wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn reg_read<P: Lsm6dsv16xPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// Writes `v` to the register `reg` and reads it back: whether the part
// holds the value.  A register with a bit that clears itself is written
// with `write_reg`.
pub fn reg_write<P: Lsm6dsv16xPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    if not p.write_reg(reg, v)
        return false
    reg_read(p, reg) == Some(v & 0xFF)

// Sets the bits of `mask` in `reg` to the bits of `v`, leaving the others:
// whether the part took it.
//
// Fix kept: many registers hold bits that "must be set to 1" or "to 0" for
// correct operation (PIN_CTRL's, SFLP_ODR's), so a whole-register write
// would change what it should not; ST's driver reads, changes and writes
// each field.
pub fn reg_update<P: Lsm6dsv16xPort>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    let Some(old) = reg_read(p, reg) else return false
    reg_write(p, reg, (old & (0xFF ^ mask)) | (v & mask))

// ── The embedded functions bank ──────────────────────────────────────

// Reads the register `reg` of the embedded functions bank, with the user
// bank put back also when the read failed: `None` when the part did not
// answer or the bank could not be put back.
//
// Fix kept: FUNC_CFG_ACCESS is the one register that every bank has, and a
// part left in the embedded bank answers other registers for every later
// read (Zephyr's driver puts the user bank back before it reads WHO_AM_I),
// so each visit ends in the user bank, as ST's driver does.
pub fn emb_read<P: Lsm6dsv16xPort>(p: P, reg: Int) -> ?Int [hw]
    if not reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, FCA_EMB_BANK)
        let _back = reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
        return None
    let v = reg_read(p, reg)
    if not reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
        return None
    v

// Sets the bits of `mask` in the register `reg` of the embedded functions
// bank to the bits of `v`, with the user bank put back also when the work
// failed: whether the part took it and the bank came back.
pub fn emb_update<P: Lsm6dsv16xPort>(p: P, reg: Int, mask: Int, v: Int) -> Bool [hw]
    if not reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, FCA_EMB_BANK)
        let _back = reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
        return false
    let done = reg_update(p, reg, mask, v)
    let back = reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
    done and back

// ── Identity ─────────────────────────────────────────────────────────

// WHO_AM_I as a `DeviceId`, or `None` when no part answers: the byte reads
// 0xFF on an SPI bus no part drives and 0x00 on one held low.
pub fn id_read<P: Lsm6dsv16xPort>(p: P) -> ?DeviceId [hw]
    let who = reg_read(p, WHO_AM_I) ?? 0xFF
    if who == 0xFF or who == 0
        return None
    Some(DeviceId { who: who, rev: None })

// ── Ranges and steps ─────────────────────────────────────────────────

// The accelerometer range a CTRL8 byte selects (§ 9.21): 00 ±2 g, 01 ±4 g,
// 10 ±8 g, 11 ±16 g.
pub fn accel_range_of(ctrl8: Int) -> AccelRange
    match ctrl8 & 3
        0 => AccelRange2g
        1 => AccelRange4g
        2 => AccelRange8g
        _ => AccelRange16g

// The FS_XL code for a range.
pub fn accel_fs_of(r: AccelRange) -> Int
    match r
        AccelRange2g  => 0
        AccelRange4g  => 1
        AccelRange8g  => 2
        AccelRange16g => 3

// The gyroscope range a CTRL6 byte selects (§ 9.19): 0001 ±250, 0010 ±500,
// 0011 ±1000, 0100 ±2000 dps.  0000 is ±125 dps and 1100 is ±4000 dps, which
// `GyroRange` has no values for; the narrowest and the widest value are
// answered, and a reserved code reads as ±250 dps.
pub fn gyro_range_of(ctrl6: Int) -> GyroRange
    match ctrl6 & 15
        2  => GyroRange500dps
        3  => GyroRange1000dps
        4  => GyroRange2000dps
        12 => GyroRange2000dps
        _  => GyroRange250dps

// The FS_G code for a range.
pub fn gyro_fs_of(r: GyroRange) -> Int
    match r
        GyroRange250dps  => 1
        GyroRange500dps  => 2
        GyroRange1000dps => 3
        GyroRange2000dps => 4

// The accelerometer step in micro-g per count (Table 3).
pub fn ug_per_count(ctrl8: Int) -> Int
    match ctrl8 & 3
        0 => 61
        1 => 122
        2 => 244
        _ => 488

// The gyroscope step in micro-degrees per second per count (Table 3).  A
// reserved code is read as ±250 dps.
pub fn udps_per_count(ctrl6: Int) -> Int
    match ctrl6 & 15
        0  => 4375
        2  => 17500
        3  => 35000
        4  => 70000
        12 => 140000
        _  => 8750

// The signed 16-bit count at `i` of `b`, low byte first.
fn s16_at(b: DevBytes, i: Int) -> Int
    dev_bus.dev_sign_extend((b[i + 1] as Int << 8) | b[i] as Int, 16)

// The milli-g of the three axes at `i` of `b`, for the step `ug`.
fn accel_at(b: DevBytes, i: Int, ug: Int) -> AccelMilliG
    AccelMilliG { x: s16_at(b, i) * ug / 1000,
        y: s16_at(b, i + 2) * ug / 1000,
        z: s16_at(b, i + 4) * ug / 1000 }

// The milli-degrees per second of the three axes at `i` of `b`, for the
// step `udps`.
fn gyro_at(b: DevBytes, i: Int, udps: Int) -> GyroMilliDps
    GyroMilliDps { x: s16_at(b, i) * udps / 1000,
        y: s16_at(b, i + 2) * udps / 1000,
        z: s16_at(b, i + 4) * udps / 1000 }

// ── Rates and operating modes ────────────────────────────────────────

// The rate in thousandths of a hertz that an ODR code selects, for the
// accelerometer (`accel`) or the gyroscope, in the rate set `series`: 0 for
// the rates of Tables 52 and 55, and, in high-accuracy ODR mode, 1 for
// HAODR_SEL 01 and 2 for HAODR_SEL 10 (Table 20).  0 for the codes a sensor
// does not have: the gyroscope has no 1.875 Hz, and the high-accuracy sets
// start at code 0011.
pub fn mhz_of_odr(code: Int, accel: Bool, series: Int) -> Int
    if code < 1 or code > 12
        return 0
    if code == 1
        if accel and series == 0
            return 1875
        return 0
    if code == 2
        if series == 0
            return 7500
        return 0
    var base = 15000
    if series == 1
        base = 15625
    if series == 2
        base = 12500
    base << (code - 3)

// Whether a code is one the sensor runs in an operating mode `op` of its
// OP_MODE field (§§ 6.2 and 6.4): the accelerometer in low-power modes has
// 1.875 Hz and 15 to 240 Hz, in normal mode 7.5 Hz to 1.92 kHz, in
// high-accuracy ODR mode 15 Hz and up; the gyroscope in low power has 7.5 to
// 240 Hz and in high-accuracy mode 15 Hz and up.
fn odr_allowed(code: Int, accel: Bool, op: Int) -> Bool
    if op == 1
        return code >= 3
    if accel
        if op >= 4 and op <= 6
            return code == 1 or code >= 3 and code <= 7
        if op == 7
            return code >= 2 and code <= 10
        return code >= 2
    if op == 5
        return code >= 2 and code <= 7
    code >= 2

// The ODR code of the slowest rate at or above `mhz` thousandths of a hertz
// that the sensor runs in the mode `op` and the rate set `series`, or of the
// fastest; 0 (power-down) for a rate of 0 or less.
pub fn odr_code_for(mhz: Int, accel: Bool, op: Int, series: Int) -> Int
    if mhz <= 0
        return 0
    var best = 2
    for code in 1..13
        if odr_allowed(code, accel, op)
            best = code
            if mhz_of_odr(code, accel, series) >= mhz
                return code
    best

// A rate in thousandths of a hertz as whole hertz: to the nearest, 0 for
// power-down.  1.875 Hz reads as 2 and 7.5 Hz as 8.
pub fn hz_of_mhz(mhz: Int) -> Int
    if mhz <= 0
        return 0
    (mhz + 500) / 1000

// HAODR_SEL, 0 to 3, or -1 when the part did not answer.
fn ha_sel<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    let Some(v) = reg_read(p, HAODR_CFG) else return -1
    v & 3

// The rate set a mode selects: HAODR_SEL in high-accuracy ODR mode, the
// ordinary rates otherwise.
fn series_of(op: Int, sel: Int) -> Int
    if op == 1
        return sel
    0

// The rate of the sensor whose control register is `reg`, in thousandths of
// a hertz: 0 when it is powered down, -1 when the part did not answer.
fn rate_read<P: Lsm6dsv16xPort>(p: P, reg: Int, accel: Bool) -> Int [hw]
    let Some(c) = reg_read(p, reg) else return -1
    let op = (c >> 4) & 7
    if (c & 15) == 0
        return 0
    var series = 0
    if op == 1
        let sel = ha_sel(p)
        if sel < 0
            return -1
        series = sel
    mhz_of_odr(c & 15, accel, series)

// Sets the sensor whose control register is `reg` to the slowest rate at or
// above `mhz` that its mode runs, in the rate set its mode selects, and
// answers the rate taken: 0 for a request of 0 or less, which powers the
// sensor down, and -1 when the part did not take it.  The gyroscope waits
// the 30 ms it takes to turn on when it was powered down.
fn rate_write<P: Lsm6dsv16xPort>(p: P, reg: Int, accel: Bool, mhz: Int) -> Int [hw]
    let Some(c) = reg_read(p, reg) else return -1
    let op = (c >> 4) & 7
    var series = 0
    if op == 1
        let sel = ha_sel(p)
        if sel < 0
            return -1
        series = sel
    let code = odr_code_for(mhz, accel, op, series)
    if not reg_update(p, reg, 0x0F, code)
        return -1
    if not accel and (c & 15) == 0 and code != 0
        p.wait_us(WAIT_GYRO_US)
    mhz_of_odr(code, accel, series)

// The accelerometer rate in thousandths of a hertz, 0 when it is powered
// down, -1 when the part did not answer.
pub fn accel_rate_read<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    rate_read(p, CTRL1, true)

// Sets the accelerometer to the slowest rate at or above `mhz` (see
// `rate_write`).
pub fn accel_rate_write<P: Lsm6dsv16xPort>(p: P, mhz: Int) -> Int [hw]
    rate_write(p, CTRL1, true, mhz)

// The gyroscope rate in thousandths of a hertz, 0 when it is powered down,
// -1 when the part did not answer.
pub fn gyro_rate_read<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    rate_read(p, CTRL2, false)

// Sets the gyroscope to the slowest rate at or above `mhz`, as
// `accel_rate_write` does.
pub fn gyro_rate_write<P: Lsm6dsv16xPort>(p: P, mhz: Int) -> Int [hw]
    rate_write(p, CTRL2, false, mhz)

// The rate in whole hertz for the traits.
pub fn accel_rate_hz_read<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    hz_of_mhz(accel_rate_read(p))

// The rate taken in whole hertz after `hz` was asked for.
pub fn accel_rate_hz_write<P: Lsm6dsv16xPort>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(accel_rate_write(p, hz * 1000))

// The gyroscope's rate in whole hertz.
pub fn gyro_rate_hz_read<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    hz_of_mhz(gyro_rate_read(p))

// The gyroscope's rate taken in whole hertz after `hz` was asked for.
pub fn gyro_rate_hz_write<P: Lsm6dsv16xPort>(p: P, hz: Int) -> Int [hw]
    hz_of_mhz(gyro_rate_write(p, hz * 1000))

// The OP_MODE_XL code for a mode (§ 9.14): 000 high performance, 001
// high-accuracy ODR, 100 low-power mode 1 (two samples averaged), 111 normal.
fn accel_mode_code(m: Lsm6dsv16xMode) -> Int
    match m
        Lsm6dsv16xHighPerf     => 0
        Lsm6dsv16xHighAccuracy => 1
        Lsm6dsv16xLowPower     => 4
        Lsm6dsv16xNormal       => 7

// The OP_MODE_G code for a mode (§ 9.15): 000 high performance, 001
// high-accuracy ODR, 101 low power.  The gyroscope has no normal mode, which
// is -1.
fn gyro_mode_code(m: Lsm6dsv16xMode) -> Int
    match m
        Lsm6dsv16xHighPerf     => 0
        Lsm6dsv16xHighAccuracy => 1
        Lsm6dsv16xLowPower     => 5
        Lsm6dsv16xNormal       => -1

// Changes the operating mode of the sensor whose control register is `reg`
// to the OP_MODE code `code` and keeps the rate or moves it to the nearest
// rate the new mode runs: whether the part took it.
//
// Fix kept: high-accuracy ODR mode has to be entered and left with the
// sensor in power-down (§ 6.5), so the sensor is powered down for such a
// change and the rate is written back after the mode.
fn mode_set<P: Lsm6dsv16xPort>(p: P, reg: Int, accel: Bool, code: Int) -> Bool [hw]
    let Some(c) = reg_read(p, reg) else return false
    let old_op = (c >> 4) & 7
    let sel = ha_sel(p)
    if sel < 0
        return false
    let odr = c & 15
    let rate = mhz_of_odr(odr, accel, series_of(old_op, sel))
    let again = odr_code_for(rate, accel, code, series_of(code, sel))
    if (old_op == 1) != (code == 1) and odr != 0
        if not reg_update(p, reg, 0x0F, 0)
            return false
    if not reg_update(p, reg, 0x70, code << 4)
        return false
    if odr == 0
        return true
    reg_update(p, reg, 0x0F, again)

// The accelerometer's operating mode, high performance when the part does
// not answer.  The three low-power modes read as low power, and a reserved
// code or ODR-triggered mode as high performance.
pub fn accel_mode_read<P: Lsm6dsv16xPort>(p: P) -> Lsm6dsv16xMode [hw]
    match ((reg_read(p, CTRL1) ?? 0) >> 4) & 7
        1 => Lsm6dsv16xHighAccuracy
        4 => Lsm6dsv16xLowPower
        5 => Lsm6dsv16xLowPower
        6 => Lsm6dsv16xLowPower
        7 => Lsm6dsv16xNormal
        _ => Lsm6dsv16xHighPerf

// Sets the accelerometer's operating mode: whether the part took it.  Low
// power is the first low-power mode, two samples averaged; `accel_lp_write`
// chooses 2, 4 or 8.
pub fn accel_mode_write<P: Lsm6dsv16xPort>(p: P, m: Lsm6dsv16xMode) -> Bool [hw]
    mode_set(p, CTRL1, true, accel_mode_code(m))

// Selects the accelerometer's low-power mode by the number of samples it
// averages, 2, 4 or 8 (OP_MODE_XL 100, 101 and 110): whether the part took
// it.  Any other number is refused.
pub fn accel_lp_write<P: Lsm6dsv16xPort>(p: P, mean: Int) -> Bool [hw]
    match mean
        2 => mode_set(p, CTRL1, true, 4)
        4 => mode_set(p, CTRL1, true, 5)
        8 => mode_set(p, CTRL1, true, 6)
        _ => false

// The gyroscope's operating mode, high performance when the part does not
// answer; sleep mode and a reserved code read as high performance.
pub fn gyro_mode_read<P: Lsm6dsv16xPort>(p: P) -> Lsm6dsv16xMode [hw]
    match ((reg_read(p, CTRL2) ?? 0) >> 4) & 7
        1 => Lsm6dsv16xHighAccuracy
        5 => Lsm6dsv16xLowPower
        _ => Lsm6dsv16xHighPerf

// Sets the gyroscope's operating mode: whether the part took it.  The
// gyroscope has no normal mode, so `Lsm6dsv16xNormal` is refused.
pub fn gyro_mode_write<P: Lsm6dsv16xPort>(p: P, m: Lsm6dsv16xMode) -> Bool [hw]
    let code = gyro_mode_code(m)
    if code < 0
        return false
    mode_set(p, CTRL2, false, code)

// Selects the rate set of high-accuracy ODR mode, HAODR_SEL 0 to 2 (§ 9.67):
// 0 the ordinary rates, 1 the rates from 15.625 Hz, 2 the rates from
// 12.5 Hz.  3 is reserved and refused.  The sensors are in power-down when
// the mode is entered, and the rate set is chosen with them in it.  Whether
// the part took it.
pub fn ha_series_write<P: Lsm6dsv16xPort>(p: P, sel: Int) -> Bool [hw]
    if sel < 0 or sel > 2
        return false
    reg_update(p, HAODR_CFG, 0x03, sel)

// ── Samples ──────────────────────────────────────────────────────────

// The most recent acceleration in milli-g: the full scales are read first,
// then the six output registers in one burst.  `None` when the part did not
// answer.
pub fn accel_read_of<P: Lsm6dsv16xPort>(p: P) -> ?AccelMilliG [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL6, 3, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_A, 6, var b)
        return None
    Some(accel_at(b, 0, ug_per_count(r[2] as Int)))

// The most recent rate of turn in milli-degrees per second, read the same
// way.
pub fn gyro_read_of<P: Lsm6dsv16xPort>(p: P) -> ?GyroMilliDps [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL6, 3, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_G, 6, var b)
        return None
    Some(gyro_at(b, 0, udps_per_count(r[0] as Int)))

// Both from one burst of twelve registers, the gyroscope's first: the two
// are one pair of samples as far as the part's registers go.
pub fn imu_read_of<P: Lsm6dsv16xPort>(p: P) -> ?ImuSample [hw]
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL6, 3, var r)
        return None
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUTX_L_G, 12, var b)
        return None
    Some(ImuSample { accel: accel_at(b, 6, ug_per_count(r[2] as Int)),
        gyro: gyro_at(b, 0, udps_per_count(r[0] as Int)) })

// Whether a new accelerometer sample has completed since the last read:
// STATUS_REG's XLDA.
pub fn accel_ready_of<P: Lsm6dsv16xPort>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS_REG) ?? 0) & ST_XLDA) != 0

// The same for the gyroscope: GDA.
pub fn gyro_ready_of<P: Lsm6dsv16xPort>(p: P) -> Bool [hw]
    ((reg_read(p, STATUS_REG) ?? 0) & ST_GDA) != 0

// The die temperature in milli-degrees Celsius: the 16-bit count at 256
// per degree, 0 at 25 °C (Table 6).  `None` when the part did not answer.
pub fn temp_read_of<P: Lsm6dsv16xPort>(p: P) -> ?TempMilliC [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(OUT_TEMP_L, 2, var b)
        return None
    Some(TempMilliC { milli_c: TEMP_ZERO_MC + s16_at(b, 0) * 1000 / TEMP_COUNTS_PER_C })

// ── Full scale ───────────────────────────────────────────────────────

// The accelerometer range, ±2 g when the part does not answer.
pub fn accel_range_read<P: Lsm6dsv16xPort>(p: P) -> AccelRange [hw]
    accel_range_of(reg_read(p, CTRL8) ?? 0)

// Sets the accelerometer range and leaves the filter bits of CTRL8: whether
// the part took it.
pub fn accel_range_write<P: Lsm6dsv16xPort>(p: P, r: AccelRange) -> Bool [hw]
    reg_update(p, CTRL8, 0x03, accel_fs_of(r))

// The gyroscope range, ±250 dps when the part does not answer.
pub fn gyro_range_read<P: Lsm6dsv16xPort>(p: P) -> GyroRange [hw]
    gyro_range_of(reg_read(p, CTRL6) ?? 1)

// Sets the gyroscope range and leaves LPF1_G_BW: whether the part took it.
pub fn gyro_range_write<P: Lsm6dsv16xPort>(p: P, r: GyroRange) -> Bool [hw]
    reg_update(p, CTRL6, 0x0F, gyro_fs_of(r))

// Sets the gyroscope's FS_G code to ±125 dps (0) or ±4000 dps (12), which
// `GyroRange` has no values for: whether the part took it.  Any other code
// is refused; the ranges of the trait are set with `gyro_range_write`.  The
// readings are converted at the code's step.
pub fn gyro_fs_code_write<P: Lsm6dsv16xPort>(p: P, code: Int) -> Bool [hw]
    if code != 0 and code != 12
        return false
    reg_update(p, CTRL6, 0x0F, code)

// ── Interrupt pins ───────────────────────────────────────────────────

// Sets INT1_CTRL to `mask`, built from the `INT1_` constants: whether the
// part took it.  `start` sets the two data-ready bits.
pub fn int1_route<P: Lsm6dsv16xPort>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT1_CTRL, mask)

// Sets INT2_CTRL to `mask`, built from the `INT2_` constants.
pub fn int2_route<P: Lsm6dsv16xPort>(p: P, mask: Int) -> Bool [hw]
    reg_write(p, INT2_CTRL, mask)

// Sets the pins' polarity and output type: `active_low` flips both pins,
// `open_drain` makes them open-drain in place of push-pull.  The other bits
// of IF_CFG stay.  Whether the part took it.
pub fn int_pins_config<P: Lsm6dsv16xPort>(p: P, active_low: Bool, open_drain: Bool) -> Bool [hw]
    var v = 0
    if active_low
        v = v | IF_H_LACTIVE
    if open_drain
        v = v | IF_PP_OD
    reg_update(p, IF_CFG, IF_H_LACTIVE | IF_PP_OD, v)

// ── The FIFO ─────────────────────────────────────────────────────────
//
// The FIFO is 1.5 KB of words of a tag byte and six data bytes, 4.5 KB with
// compression (§ 6.12).  It is off after `start`.  `fifo_start` turns it on
// in continuous mode, which overwrites the oldest word when it is full,
// batches the accelerometer at its present rate and the gyroscope too when
// asked, and puts the watermark on INT1 in place of the data-ready flags.
// The words arrive in the order the sensors produce them, and the tag byte
// names each one: the gyroscope's (1), the accelerometer's (2) or the game
// rotation vector's (0x13).  The part counts words of every kind.
// Compression is off.

// The number of words in the FIFO, 0 when it is empty or the part did not
// answer: DIFF_FIFO, nine bits over two registers.
pub fn fifo_count<P: Lsm6dsv16xPort>(p: P) -> Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(FIFO_STATUS1, 2, var b)
        return 0
    b[0] as Int | ((b[1] as Int & 1) << 8)

// Turns the FIFO on in continuous mode with the watermark at `threshold`
// words, 1 to 255, and puts the watermark on INT1 in place of the
// data-ready flags: whether the part took every setting.  The accelerometer
// is batched at the rate it runs at and the gyroscope, when `with_gyro`, at
// its rate.
//
// Fix kept: ST's FIFO examples set the FIFO to bypass before they change its
// configuration, and write the mode last, as this does; the compression
// bits of FIFO_CTRL2 are cleared, and its reserved bits left as they are.
pub fn fifo_start<P: Lsm6dsv16xPort>(p: P, threshold: Int, with_gyro: Bool) -> Bool [hw]
    var th = threshold
    if th < 1
        th = 1
    if th > FIFO_WTM_MAX
        th = FIFO_WTM_MAX
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL1, 2, var r)
        return false
    var gy = 0
    if with_gyro
        gy = r[1] as Int & 15
    if not reg_update(p, FIFO_CTRL4, 0x07, FIFO_BYPASS)
        return false
    if not reg_write(p, FIFO_CTRL1, th)
        return false
    if not reg_update(p, FIFO_CTRL2, 0xD7, 0)
        return false
    if not reg_write(p, FIFO_CTRL3, (gy << 4) | (r[0] as Int & 15))
        return false
    if not reg_update(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G | INT1_FIFO_TH, INT1_FIFO_TH)
        return false
    reg_update(p, FIFO_CTRL4, 0x07, FIFO_CONTINUOUS)

// Turns the FIFO off, which empties it, stops the batching and puts the
// data-ready flags back on INT1: whether the part took every setting.
pub fn fifo_stop<P: Lsm6dsv16xPort>(p: P) -> Bool [hw]
    if not reg_update(p, FIFO_CTRL4, 0x07, FIFO_BYPASS)
        return false
    if not reg_write(p, FIFO_CTRL3, 0)
        return false
    reg_update(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G | INT1_FIFO_TH, INT1_DRDY_XL | INT1_DRDY_G)

// Takes one word out of the FIFO into `b`, the tag byte first and the six
// data bytes after it, in one burst: the tag's sensor field (TAG_SENSOR in
// bits 7:3), 0 for an empty FIFO, or -1 when the part did not answer.
fn fifo_word<P: Lsm6dsv16xPort>(p: P, var b: DevBytes) -> Int [hw]
    if not p.read_regs(FIFO_DATA_OUT_TAG, 7, var b)
        return -1
    b[0] as Int >> 3

// Moves the accelerometer's words of the FIFO, oldest first, into `dst`,
// which is emptied first, and answers how many words it took out.  A word
// of the gyroscope or of any other kind is taken out and dropped; a program
// that batches both reads with `fifo_read_imu`.  The count is read once and
// the full scale once.
pub fn fifo_read<P: Lsm6dsv16xPort>(p: P, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL8, 1, var r)
        return 0
    let ug = ug_per_count(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if dst.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        let tag = fifo_word(p, var b)
        if tag < 0
            break
        moved = moved + 1
        if tag == TAG_ACCEL
            let _ = dst.push(accel_at(b, 1, ug))
    moved

// Moves the FIFO's words into `accel` and `gyro`, each emptied first, oldest
// first, and answers how many words it took out.  It stops when either list
// is full, so no word is taken out without room.  A word of another kind is
// taken out and dropped.
pub fn fifo_read_imu<P: Lsm6dsv16xPort>(p: P, var accel: Vec[AccelMilliG; 32],
                                        var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
    accel.clear()
    gyro.clear()
    let n = fifo_count(p)
    if n == 0
        return 0
    var r: DevBytes = Vec.new()
    if not p.read_regs(CTRL6, 3, var r)
        return 0
    let ug = ug_per_count(r[2] as Int)
    let udps = udps_per_count(r[0] as Int)
    var moved = 0
    for _i in 0..n
        if accel.len() >= LIST_DEPTH or gyro.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        let tag = fifo_word(p, var b)
        if tag < 0
            break
        moved = moved + 1
        if tag == TAG_ACCEL
            let _ = accel.push(accel_at(b, 1, ug))
        elif tag == TAG_GYRO
            let _ = gyro.push(gyro_at(b, 1, udps))
    moved

// ── The game rotation vector ─────────────────────────────────────────
//
// The sensor fusion low-power block (SFLP, § 2.8) computes from the
// accelerometer and the gyroscope the attitude of the device as a unit
// quaternion, the game rotation vector, and writes it to the FIFO as a word
// tagged 0x13.  The six data bytes are the quaternion's x, y and z as
// IEEE 754 half-precision numbers, low byte first; w is not stored and is
// the square root of one minus the sum of their squares.  The block is
// enabled in the embedded functions bank, runs at its own rate (15 to 480
// Hz), and needs the accelerometer and the gyroscope on at that rate or
// faster.

// Enables the game rotation vector (SFLP_GAME_EN of EMB_FUNC_EN_A) or
// disables it: whether the part took it and the user bank came back.
pub fn sflp_enable<P: Lsm6dsv16xPort>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if on
        v = 0x02
    emb_update(p, EMB_FUNC_EN_A, 0x02, v)

// Sets the rate of the block, SFLP_GAME_ODR 0 to 5: 15, 30, 60, 120 (the
// default), 240 and 480 Hz (§ 13.30).  A higher code is refused.  Whether
// the part took it.
//
// Fix kept: SFLP_ODR holds bits that must be 1 and bits that must be 0 for
// correct operation, so only the rate field is changed.
pub fn sflp_rate_write<P: Lsm6dsv16xPort>(p: P, ctrl: Int) -> Bool [hw]
    if ctrl < 0 or ctrl > 5
        return false
    emb_update(p, SFLP_ODR, 0x38, ctrl << 3)

// Puts the game rotation vector in the FIFO (SFLP_GAME_FIFO_EN of
// EMB_FUNC_FIFO_EN_A) or takes it out: whether the part took it.
pub fn sflp_fifo_write<P: Lsm6dsv16xPort>(p: P, on: Bool) -> Bool [hw]
    var v = 0
    if on
        v = 0x02
    emb_update(p, EMB_FUNC_FIFO_EN_A, 0x02, v)

// Starts the block over (SFLP_GAME_INIT of EMB_FUNC_INIT_A, a request that
// does not read back): whether the part took it.
pub fn sflp_reset<P: Lsm6dsv16xPort>(p: P) -> Bool [hw]
    if not reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, FCA_EMB_BANK)
        let _back = reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
        return false
    let done = p.write_reg(EMB_FUNC_INIT_A, 0x02)
    let back = reg_update(p, FUNC_CFG_ACCESS, FCA_BANK_MASK, 0)
    done and back

// A half-precision number as millionths: the sign, the exponent (5 bits)
// and the mantissa (10 bits) of IEEE 754 binary16, rounded to the nearest.
// The numbers of a quaternion are at most 1 in magnitude; the infinities
// and the not-a-numbers (exponent 31) are read as 0 and a magnitude of 2 or
// more is limited to 2.
pub fn half_to_micro(h: Int) -> Int
    let sign = (h >> 15) & 1
    let e = (h >> 10) & 31
    let m = h & 1023
    if e == 31
        return 0
    var mag = 0
    if e == 0
        mag = (m * 1000000 + 8388608) >> 24
    elif e >= 25
        mag = 2000000
    else
        mag = ((1024 + m) * 1000000 + (1 << (24 - e))) >> (25 - e)
    if mag > 2000000
        mag = 2000000
    if sign == 1
        return 0 - mag
    mag

// The integer square root of `n`, 0 to 2^44, by 22 steps of the bitwise
// method.
pub fn isqrt(n: Int) -> Int
    if n <= 0
        return 0
    var res = 0
    for k in 0..22
        let cand = res + (1 << (21 - k))
        if cand * cand <= n
            res = cand
    res

// The quaternion of the six data bytes at `i` of `b`: x, y and z from the
// half-precision numbers, and w the square root of one minus their squares
// (ST's `sflp2q`).  A vector longer than 1 is scaled to length 1 first, and
// w is then 0.
pub fn quat_at(b: DevBytes, i: Int) -> Lsm6dsv16xQuat
    var x = half_to_micro((b[i + 1] as Int << 8) | b[i] as Int)
    var y = half_to_micro((b[i + 3] as Int << 8) | b[i + 2] as Int)
    var z = half_to_micro((b[i + 5] as Int << 8) | b[i + 4] as Int)
    var sumsq = x * x + y * y + z * z
    if sumsq > 1000000000000
        let n = isqrt(sumsq)
        x = x * 1000000 / n
        y = y * 1000000 / n
        z = z * 1000000 / n
        sumsq = 1000000000000
    Lsm6dsv16xQuat { x: x, y: y, z: z, w: isqrt(1000000000000 - sumsq) }

// Moves the game rotation vectors of the FIFO, oldest first, into `dst`,
// which is emptied first, and answers how many words it took out.  A word
// of any other kind is taken out and dropped.
pub fn fifo_read_quat<P: Lsm6dsv16xPort>(p: P, var dst: Vec[Lsm6dsv16xQuat; 32]) -> Int [hw]
    dst.clear()
    let n = fifo_count(p)
    var moved = 0
    for _i in 0..n
        if dst.len() >= LIST_DEPTH
            break
        var b: DevBytes = Vec.new()
        let tag = fifo_word(p, var b)
        if tag < 0
            break
        moved = moved + 1
        if tag == TAG_SFLP_GAME
            let _ = dst.push(quat_at(b, 1))
    moved

// ── Self-test ────────────────────────────────────────────────────────

// Waits for a new-data flag of STATUS_REG by polling it, at most
// `SELF_TEST_POLLS` times: whether it came.
fn wait_status<P: Lsm6dsv16xPort>(p: P, flag: Int) -> Bool [hw]
    for _i in 0..SELF_TEST_POLLS
        if ((reg_read(p, STATUS_REG) ?? 0) & flag) != 0
            return true
    false

// Lets `ST_SKIP` samples pass and averages the next `ST_AVERAGE`, in
// milli-g: `None` when a sample did not come.
fn accel_mean<P: Lsm6dsv16xPort>(p: P) -> ?AccelMilliG [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SKIP + ST_AVERAGE
        if not wait_status(p, ST_XLDA)
            return None
        let Some(s) = accel_read_of(p) else return None
        if i >= ST_SKIP
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(AccelMilliG { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The same for the gyroscope, in milli-degrees per second.
fn gyro_mean<P: Lsm6dsv16xPort>(p: P) -> ?GyroMilliDps [hw]
    var sx = 0
    var sy = 0
    var sz = 0
    for i in 0..ST_SKIP + ST_AVERAGE
        if not wait_status(p, ST_GDA)
            return None
        let Some(s) = gyro_read_of(p) else return None
        if i >= ST_SKIP
            sx = sx + s.x
            sy = sy + s.y
            sz = sz + s.z
    Some(GyroMilliDps { x: sx / ST_AVERAGE, y: sy / ST_AVERAGE, z: sz / ST_AVERAGE })

// The change the accelerometer's self-test makes to its outputs (Table 3,
// the procedure of ST's `lsm6dsv16x_self_test` example): the sensor at 60 Hz
// and ±4 g with block data update is read with the self-test off and again
// with it on, positive or `negative`, five samples averaged each time after
// the output has settled for 100 ms and one sample has passed, and the
// answer is the second mean minus the first, in milli-g.  The rate, the mode
// and the range the sensor had are put back.  The board must be still.
// `None` when the part did not answer or a sample did not come.
//
// Table 3 gives the change as 50 to 1700 mg, whatever the full scale;
// `accel_self_test_within` compares a change with those limits.
pub fn accel_self_test<P: Lsm6dsv16xPort>(p: P, negative: Bool) -> ?AccelMilliG [hw]
    var save: DevBytes = Vec.new()
    if not p.read_regs(CTRL1, 1, var save)
        return None
    let Some(c8) = reg_read(p, CTRL8) else return None
    var st = C10_ST_XL_POS
    if negative
        st = C10_ST_XL_NEG
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_update(p, CTRL3, C3_BDU, C3_BDU) and reg_update(p, CTRL8, 0x03, XL_ST_FS) and reg_write(p, CTRL1, XL_ST_ODR)
        p.wait_us(WAIT_SETTLE_US)
        if let Some(off) = accel_mean(p)
            if reg_update(p, CTRL10, C10_ST_XL_MASK, st)
                p.wait_us(WAIT_SETTLE_US)
                if let Some(on) = accel_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_update(p, CTRL10, C10_ST_XL_MASK, 0)
    let _back_c1 = reg_write(p, CTRL1, save[0] as Int)
    let _back_c8 = reg_write(p, CTRL8, c8)
    if not ok
        return None
    Some(AccelMilliG { x: dx, y: dy, z: dz })

// The change the gyroscope's self-test makes: the sensor at 240 Hz and
// ±2000 dps, read with the self-test off and on, in milli-degrees per
// second.  Table 3 gives 150 to 700 dps at ±2000 dps.
pub fn gyro_self_test<P: Lsm6dsv16xPort>(p: P, negative: Bool) -> ?GyroMilliDps [hw]
    var save: DevBytes = Vec.new()
    if not p.read_regs(CTRL2, 1, var save)
        return None
    let Some(c6) = reg_read(p, CTRL6) else return None
    var st = C10_ST_G_POS
    if negative
        st = C10_ST_G_NEG
    var ok = false
    var dx = 0
    var dy = 0
    var dz = 0
    if reg_update(p, CTRL3, C3_BDU, C3_BDU) and reg_update(p, CTRL6, 0x0F, G_ST_FS) and reg_write(p, CTRL2, G_ST_ODR)
        p.wait_us(WAIT_SETTLE_US)
        if let Some(off) = gyro_mean(p)
            if reg_update(p, CTRL10, C10_ST_G_MASK, st)
                p.wait_us(WAIT_SETTLE_US)
                if let Some(on) = gyro_mean(p)
                    dx = on.x - off.x
                    dy = on.y - off.y
                    dz = on.z - off.z
                    ok = true
    let _back_st = reg_update(p, CTRL10, C10_ST_G_MASK, 0)
    let _back_c2 = reg_write(p, CTRL2, save[0] as Int)
    let _back_c6 = reg_write(p, CTRL6, c6)
    if not ok
        return None
    Some(GyroMilliDps { x: dx, y: dy, z: dz })

// The magnitude of `v`.
fn abs_of(v: Int) -> Int
    if v < 0
        return 0 - v
    v

// Whether every axis of the accelerometer self-test change `d` is 50 to
// 1700 mg in magnitude (Table 3).
pub fn accel_self_test_within(d: AccelMilliG) -> Bool
    abs_of(d.x) >= 50 and abs_of(d.x) <= 1700 and abs_of(d.y) >= 50 and abs_of(d.y) <= 1700 and abs_of(d.z) >= 50 and abs_of(d.z) <= 1700

// Whether every axis of the gyroscope self-test change `d` is 150 to 700
// dps in magnitude (Table 3, at ±2000 dps).
pub fn gyro_self_test_within(d: GyroMilliDps) -> Bool
    abs_of(d.x) >= 150000 and abs_of(d.x) <= 700000 and abs_of(d.y) >= 150000 and abs_of(d.y) <= 700000 and abs_of(d.z) >= 150000 and abs_of(d.z) <= 700000

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready; the user bank selected; WHO_AM_I
// checked; a global reset (SW_POR) and its 30 ms; block data update and the
// address increment on; on SPI the I2C block off; data-ready masked while
// the filters settle; both data-ready flags on INT1; and both sensors at
// 120 Hz in high-performance mode, ±2 g and ±250 dps, and the gyroscope's
// 30 ms turn-on waited.  Answers whether the part answered as an LSM6DSV16X
// and took every setting.
//
// Fixes kept: Zephyr's driver puts the part in the user bank before it
// reads WHO_AM_I, since a part left in an embedded-function bank answers
// other registers there, and resets it with SW_POR and a wait of 30 ms
// (from AN5763); IF_CFG and PIN_CTRL survive SW_RESET, which SW_POR
// resets, so the interface settings are written after it; ST's examples
// enable block data update after the reset.
pub fn start<P: Lsm6dsv16xPort>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if not reg_write(p, FUNC_CFG_ACCESS, 0)
        return false
    if reg_read(p, WHO_AM_I) != Some(ID_LSM6DSV16X)
        return false
    if not p.write_reg(FUNC_CFG_ACCESS, FCA_SW_POR)
        return false
    p.wait_us(WAIT_RESET_US)
    if not reg_write(p, CTRL3, C3_BDU | C3_IF_INC)
        return false
    if p.on_spi()
        if not reg_update(p, IF_CFG, IF_I2C_DISABLE, IF_I2C_DISABLE)
            return false
    if not reg_update(p, CTRL4, C4_DRDY_MASK, C4_DRDY_MASK)
        return false
    if not reg_update(p, CTRL8, 0x03, 0)
        return false
    if not reg_update(p, CTRL6, 0x0F, 1)
        return false
    if not reg_write(p, INT1_CTRL, INT1_DRDY_XL | INT1_DRDY_G)
        return false
    if not reg_write(p, CTRL2, ODR_120)
        return false
    if not reg_write(p, CTRL1, ODR_120)
        return false
    p.wait_us(WAIT_GYRO_US)
    true

// ── The part on an I2C bus ───────────────────────────────────────────

// An LSM6DSV16X on a board's I2C bus at the address `w.addr`, 0x6A or 0x6B,
// with the board's GPIO for the INT1 line and its timer.
pub @value
struct Lsm6dsv16x
    bus: BoardI2c
    pins: BoardGpio
    timer: BoardTimer
    w: DeviceWiring

impl Lsm6dsv16xPort for Lsm6dsv16x
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_reg(self, reg: Int, v: Int) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, v)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn on_spi(self) -> Bool [hw]
        false

    fn wait_us(self, us: Int) [hw]
        self.timer.delay_us(us)

impl Lsm6dsv16x
    // The part at `w.addr` on the board's I2C bus, as a board's device
    // table builds it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring) -> Lsm6dsv16x
        Lsm6dsv16x { bus: bus, pins: pins, timer: BoardTimer { id: 0 }, w: w }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self)

    // One register's byte, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self, r)

    // Writes a register and reads it back.
    fn set_reg(self, r: Int, v: Int) -> Bool [hw]
        reg_write(self, r, v)

    // A register of the embedded functions bank.
    fn emb_reg(self, r: Int) -> ?Int [hw]
        emb_read(self, r)

    fn set_emb_reg(self, r: Int, mask: Int, v: Int) -> Bool [hw]
        emb_update(self, r, mask, v)

    // The gyroscope's setter for the rate, and the rates in thousandths of
    // a hertz.
    fn gyro_set_rate_hz(self, hz: Int) -> Int [hw]
        gyro_rate_hz_write(self, hz)

    fn accel_rate_mhz(self) -> Int [hw]
        accel_rate_read(self)

    fn set_accel_rate_mhz(self, mhz: Int) -> Int [hw]
        accel_rate_write(self, mhz)

    fn gyro_rate_mhz(self) -> Int [hw]
        gyro_rate_read(self)

    fn set_gyro_rate_mhz(self, mhz: Int) -> Int [hw]
        gyro_rate_write(self, mhz)

    // The gyroscope at ±125 dps or ±4000 dps (code 0 or 12).
    fn gyro_set_fs_code(self, code: Int) -> Bool [hw]
        gyro_fs_code_write(self, code)

    // The operating modes of the two sensors and the high-accuracy rate
    // set.
    fn accel_mode(self) -> Lsm6dsv16xMode [hw]
        accel_mode_read(self)

    fn set_accel_mode(self, m: Lsm6dsv16xMode) -> Bool [hw]
        accel_mode_write(self, m)

    fn set_accel_lp(self, mean: Int) -> Bool [hw]
        accel_lp_write(self, mean)

    fn gyro_mode(self) -> Lsm6dsv16xMode [hw]
        gyro_mode_read(self)

    fn set_gyro_mode(self, m: Lsm6dsv16xMode) -> Bool [hw]
        gyro_mode_write(self, m)

    fn set_ha_series(self, sel: Int) -> Bool [hw]
        ha_series_write(self, sel)

    // The interrupt pins.
    fn route_int1(self, mask: Int) -> Bool [hw]
        int1_route(self, mask)

    fn route_int2(self, mask: Int) -> Bool [hw]
        int2_route(self, mask)

    fn configure_pins(self, active_low: Bool, open_drain: Bool) -> Bool [hw]
        int_pins_config(self, active_low, open_drain)

    // The FIFO: on, off, and the gyroscope's words and the accelerometer's.
    fn fifo_begin(self, threshold: Int, with_gyro: Bool) -> Bool [hw]
        fifo_start(self, threshold, with_gyro)

    fn fifo_end(self) -> Bool [hw]
        fifo_stop(self)

    fn fifo_take_imu(self, var accel: Vec[AccelMilliG; 32],
                     var gyro: Vec[GyroMilliDps; 32]) -> Int [hw]
        fifo_read_imu(self, var accel, var gyro)

    // The game rotation vector: on and off, its rate, its place in the FIFO,
    // the restart and the quaternions out of the FIFO.
    fn set_fusion(self, on: Bool) -> Bool [hw]
        sflp_enable(self, on)

    fn set_fusion_rate(self, ctrl: Int) -> Bool [hw]
        sflp_rate_write(self, ctrl)

    fn set_fusion_fifo(self, on: Bool) -> Bool [hw]
        sflp_fifo_write(self, on)

    fn reset_fusion(self) -> Bool [hw]
        sflp_reset(self)

    fn fifo_take_quat(self, var dst: Vec[Lsm6dsv16xQuat; 32]) -> Int [hw]
        fifo_read_quat(self, var dst)

    // The self-tests (`accel_self_test`, `gyro_self_test`).
    fn accel_test(self, negative: Bool) -> ?AccelMilliG [hw]
        accel_self_test(self, negative)

    fn gyro_test(self, negative: Bool) -> ?GyroMilliDps [hw]
        gyro_self_test(self, negative)

impl Accelerometer[hw] for Lsm6dsv16x
    fn accel_read(self) -> ?AccelMilliG [hw]
        accel_read_of(self)

    fn accel_ready(self) -> Bool [hw]
        accel_ready_of(self)

    fn accel_range(self) -> AccelRange [hw]
        accel_range_read(self)

    fn accel_set_range(self, r: AccelRange) -> Bool [hw]
        accel_range_write(self, r)

    // The rate in whole hertz, to the nearest; 0 when the sensor is off.
    fn accel_rate_hz(self) -> Int [hw]
        accel_rate_hz_read(self)

    // 0 powers the sensor down.
    fn accel_set_rate_hz(self, hz: Int) -> Int [hw]
        accel_rate_hz_write(self, hz)

    // Words in the FIFO, of every kind that is batched.
    fn accel_fifo_count(self) -> Int [hw]
        fifo_count(self)

    fn accel_fifo_read(self, var dst: Vec[AccelMilliG; 32]) -> Int [hw]
        fifo_read(self, var dst)

impl Gyroscope[hw] for Lsm6dsv16x
    fn gyro_read(self) -> ?GyroMilliDps [hw]
        gyro_read_of(self)

    fn gyro_ready(self) -> Bool [hw]
        gyro_ready_of(self)

    fn gyro_range(self) -> GyroRange [hw]
        gyro_range_read(self)

    fn gyro_set_range(self, r: GyroRange) -> Bool [hw]
        gyro_range_write(self, r)

    fn gyro_rate_hz(self) -> Int [hw]
        gyro_rate_hz_read(self)

impl Imu[hw] for Lsm6dsv16x
    fn imu_read(self) -> ?ImuSample [hw]
        imu_read_of(self)

impl Thermometer[hw] for Lsm6dsv16x
    // The sensor converts by itself while a motion sensor is on, so
    // nothing is started and no time is needed.
    fn temp_start(self) -> Int [hw]
        0

    fn temp_read(self) -> ?TempMilliC [hw]
        temp_read_of(self)

impl Identifiable[hw] for Lsm6dsv16x
    // WHO_AM_I, 0x70; the part keeps no revision register, so `rev` is
    // `None`.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)

